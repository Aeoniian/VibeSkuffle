+/// `ExternalInterface.call` from the movie goes to Skua as an event (Skua never returns a
+/// value to the movie, the same as with the Flash control).
+pub struct SkuaExternalInterfaceProvider {
+    pub spoof_url: Option<Url>,
+}
+
+impl ExternalInterfaceProvider for SkuaExternalInterfaceProvider {
+    fn call_method(&self, _context: &mut UpdateContext<'_>, name: &str, args: &[Value]) -> Value {
+        // Like the desktop provider: answer "where am I" questions locally.
+        if let Some(url) = &self.spoof_url {
+            let asks_location = |code: &str| {
+                matches!(
+                    code,
+                    "document.location.href" | "window.location.href" | "top.location.href"
+                )
+            };
+            if name.strip_suffix(".toString").is_some_and(asks_location)
+                || (name == "eval"
+                    && matches!(args, [Value::String(code)] if asks_location(code)))
+            {
+                return Value::String(url.to_string());
+            }
+        }
+        send(json!({
+            "t": "ev",
+            "n": name,
+            "a": args.iter().map(to_json).collect::<Vec<_>>(),
+        }));
+        Value::Undefined
+    }
+
+    fn on_callback_available(&self, name: &str) {
+        send(json!({ "t": "cb", "n": name }));
+    }
+
+    fn get_id(&self) -> Option<String> {
+        None
+    }
+}
