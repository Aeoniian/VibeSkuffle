@@ -0,0 +1,92 @@
+//! Frontends must check admission before rendering commits cacheAsBitmap updates.
+//! Only a completion callback can retire a submission; a timeout never does.
+use std::collections::VecDeque;
+use std::sync::{Arc, atomic::{AtomicBool, Ordering}};
+
+pub(crate) struct FrameQueue<T> {
+    pending: VecDeque<(T, Arc<AtomicBool>)>,
+}
+
+impl<T> Default for FrameQueue<T> {
+    fn default() -> Self { Self { pending: VecDeque::new() } }
+}
+
+impl<T> FrameQueue<T> {
+    pub fn submitted(&mut self, index: T) -> Arc<AtomicBool> {
+        self.reap();
+        let done = Arc::new(AtomicBool::new(false));
+        self.pending.push_back((index, done.clone()));
+        done
+    }
+
+    fn reap(&mut self) {
+        while self.pending.front().is_some_and(|(_, done)| done.load(Ordering::Acquire)) {
+            self.pending.pop_front();
+        }
+    }
+    pub fn ready(&mut self) -> bool { self.reap(); self.pending.len() < 2 }
+    pub fn over_limit(&mut self) -> bool { self.reap(); self.pending.len() > 2 }
+    pub fn oldest(&self) -> Option<&T> { self.pending.front().map(|(index, _)| index) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn slow_gpu_never_loses_outstanding_work() {
+        let mut queue = FrameQueue::default();
+        let a = queue.submitted(0u32); let b = queue.submitted(0u32);
+        for _ in 0..1000 { assert!(!queue.ready()); }
+        assert_eq!(queue.pending.len(), 2);
+        a.store(true, Ordering::Release);
+        assert!(queue.ready());
+        let c = queue.submitted(0u32);
+        assert!(!queue.ready());
+        b.store(true, Ordering::Release); c.store(true, Ordering::Release);
+        assert!(queue.ready()); assert!(queue.pending.is_empty());
+    }
+    #[test]
+    fn later_callback_does_not_retire_earlier_work() {
+        let mut queue = FrameQueue::default();
+        let a = queue.submitted(0u32); let b = queue.submitted(0u32);
+        b.store(true, Ordering::Release);
+        assert!(!queue.ready());
+        a.store(true, Ordering::Release); assert!(queue.ready());
+    }
+    #[test]
+    fn completion_across_threads_restores_admission() {
+        let mut queue = FrameQueue::default();
+        let a = queue.submitted(0u32); let b = queue.submitted(0u32);
+        std::thread::spawn(move || {
+            a.store(true, Ordering::Release); b.store(true, Ordering::Release);
+        }).join().unwrap();
+        assert!(queue.ready());
+    }
+    #[test]
+    fn offscreen_timeout_keeps_oldest_index_until_completion() {
+        let mut queue = FrameQueue::default();
+        let a=queue.submitted(11u32);
+        let b=queue.submitted(12u32);
+        let c=queue.submitted(13u32);
+        for _ in 0..1000 {
+            assert!(queue.over_limit());
+            assert_eq!(queue.oldest(),Some(&11));
+        }
+        a.store(true,Ordering::Release);
+        assert!(!queue.over_limit());
+        assert_eq!(queue.oldest(),Some(&12));
+        b.store(true,Ordering::Release);c.store(true,Ordering::Release);
+        assert!(queue.ready());
+    }
+    #[test]
+    fn serial_offscreen_work_does_not_accumulate_completed_tickets() {
+        let mut queue=FrameQueue::default();
+        for id in 0..10000 {
+            let done=queue.submitted(id);
+            done.store(true,Ordering::Release);
+        }
+        assert_eq!(queue.pending.len(),1);
+        assert!(queue.ready());
+        assert!(queue.pending.is_empty());
+    }
+}
