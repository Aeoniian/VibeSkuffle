+/// Gives keyboard focus to the game window when it's clicked inside Skua's panel (a child
+/// window doesn't get it on its own).
+#[cfg(windows)]
+pub fn focus(hwnd: isize) {
+    // SAFETY: a plain Win32 call on our own window handle.
+    unsafe {
+        windows_sys::Win32::UI::Input::KeyboardAndMouse::SetFocus(hwnd as _);
+    }
+}
+
+#[cfg(not(windows))]
+pub fn focus(_hwnd: isize) {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn values_round_trip() {
+        let value = Value::List(vec![
+            Value::Undefined,
+            Value::Null,
+            Value::Bool(true),
+            Value::Number(1.5),
+            Value::Number(f64::INFINITY),
+            Value::String("a & <b>".into()),
+            Value::Object(BTreeMap::from([("k".to_string(), Value::Number(3.0))])),
+        ]);
+        let back = from_json(&to_json(&value));
+        assert_eq!(format!("{back:?}"), format!("{value:?}"));
+    }
+
+    #[test]
+    fn args_are_taken() {
+        let mut args: Vec<OsString> = ["ruffle", "--skua-pipe", "p1", "--skua-parent=0x1F", "--skua-movie", "C:\\s.swf", "--width", "5"]
+            .into_iter()
+            .map(OsString::from)
+            .collect();
+        let movie = take_args(&mut args);
+        assert_eq!(movie, Some(OsString::from("C:\\s.swf")));
+        assert_eq!(args, ["ruffle", "--width", "5"].map(OsString::from).to_vec());
+        assert_eq!(parent(), Some(0x1F));
+    }
+}
