 impl MainWindow {
+    /// Skua build: a request from Skua (see `skua.rs`).
+    fn skua_request(&mut self, event_loop: &ActiveEventLoop, request: crate::skua::Request) {
+        use crate::skua::Request;
+        match request {
+            Request::Call { id, name, args } => {
+                let value = match self.player.get() {
+                    Some(mut player) => player.call_internal_interface(&name, args),
+                    None => ruffle_core::external::Value::Undefined,
+                };
+                crate::skua::reply(id, &value);
+            }
+            Request::Headless(on) => {
+                crate::skua::set_headless(on);
+                self.next_draw_time = None;
+                self.picture_due = Instant::now();
+                if on {
+                    if let Some(bytes) = crate::render_policy::headless_budget()
+                        && let Some(mut player) = self.player.get()
+                        && let Some(renderer) = <dyn std::any::Any>::downcast_mut::<
+                            ruffle_render_wgpu::backend::WgpuRenderBackend<crate::gui::MovieView>,
+                        >(player.renderer_mut())
+                    {
+                        renderer.aqw_trim_idle_to_budget(bytes);
+                    }
+                }
+                if !on {
+                    self.frame_since_render = true;
+                    self.gui.window().request_redraw();
+                }
+            }
+            Request::Refresh => {
+                // Skua's window came back (restored, tab shown): draw again even if the last
+                // size event made us think we were minimized.
+                let size = self.gui.window().inner_size();
+                if size.width > 0 && size.height > 0 {
+                    self.minimized = false;
+                    self.gui.resize(size);
+                }
+                self.occluded = false;
+                self.frame_since_render = true;
+                self.gui.window().request_redraw();
+            }
+            Request::Trim => {
+                if let Some(mut player) = self.player.get() {
+                    // Same clean-up Mugetsu does when graphics memory runs low: shapes not drawn
+                    // for 2 minutes are tessellated again if they come back.
+                    let shapes = ruffle_core::evict_unused_shapes(120);
+                    if let Some(renderer) = <dyn std::any::Any>::downcast_mut::<
+                        ruffle_render_wgpu::backend::WgpuRenderBackend<crate::gui::MovieView>,
+                    >(player.renderer_mut())
+                    {
+                        renderer.aqw_trim_memory();
+                    }
+                    // Give memory the allocator keeps for reuse back to Windows.
+                    // SAFETY: plain call, no arguments to get wrong.
+                    unsafe { libmimalloc_sys::mi_collect(true) };
+                    tracing::info!(target: "ruffle_aqw_perf", "skua trim: freed {shapes} unused shapes and spare textures");
+                }
+            }
+            Request::Quit => event_loop.exit(),
+            Request::Set { key, on } => {
+                use crate::mugetsu::Setting;
+                let setting = match key.as_str() {
+                    "interpolation" => Some(Setting::Interpolation(on)),
+                    "edges" => Some(Setting::FlashEdges(on)),
+                    "fps" => Some(Setting::ShowFps(on)),
+                    "logs" => Some(Setting::OpenLogFolder),
+                    other => {
+                        tracing::warn!("Unknown setting from Skua: {other}");
+                        None
+                    }
+                };
+                if let Some(setting) = setting {
+                    self.apply_setting(setting);
+                }
+                crate::skua::send_settings();
+            }
+            Request::GetSettings => crate::skua::send_settings(),
+        }
+    }
