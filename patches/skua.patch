@@ -0,0 +1,515 @@
+//! Skua bridge: lets Skua (a C# bot client) drive the game through `ExternalInterface`, the
+//! same way it drives the Flash ActiveX control, over two pipes:
+//!
+//! * `<name>-c2r`: Skua -> Ruffle (calls into AS3 callbacks, headless on/off, quit)
+//! * `<name>-r2c`: Ruffle -> Skua (call results, `ExternalInterface.call` events, hello)
+//!
+//! Two one-way pipes instead of one duplex pipe: on Windows a blocking read on a synchronous
+//! handle stalls writes on the same handle.
+//!
+//! Every message is a 4-byte little-endian length followed by that many bytes of UTF-8 JSON.
+//! `ExternalInterface` values map to JSON as: null -> null, undefined -> {"$u":1}, booleans,
+//! numbers (NaN/Infinity as {"$n":"NaN"} etc.), strings, arrays and objects as {"$o":{...}}.
+//!
+//! Started with `--skua-pipe <name> --skua-movie <skua.swf> [--skua-parent <hwnd>]`; those
+//! arguments are removed before Ruffle's own options are parsed (see `take_args`).
+
+use crate::custom_event::RuffleEvent;
+use ruffle_core::context::UpdateContext;
+use ruffle_core::external::{ExternalInterfaceProvider, Value};
+use serde_json::{Map, Number, Value as Json, json};
+use std::collections::BTreeMap;
+use std::ffi::OsString;
+use std::fs::{File, OpenOptions};
+use std::io::{BufReader, BufWriter, Read, Write};
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+use url::Url;
+use winit::event_loop::EventLoopProxy;
+
+pub struct Config {
+    pub pipe: String,
+    /// Window handle (HWND) of Skua's panel to draw inside, if any.
+    pub parent: Option<isize>,
+}
+
+static CONFIG: OnceLock<Config> = OnceLock::new();
+static HEADLESS: AtomicBool = AtomicBool::new(false);
+static OUTBOX: OnceLock<mpsc::Sender<Vec<u8>>> = OnceLock::new();
+
+/// A request from Skua, delivered to the event loop as `RuffleEvent::Skua`.
+pub enum Request {
+    Call {
+        id: u64,
+        name: String,
+        args: Vec<Value>,
+    },
+    Headless(bool),
+    /// Redraw now (Skua's window was restored or shown again).
+    Refresh,
+    /// Free memory the game isn't using right now (the account's tab is in the background):
+    /// shapes not drawn for a while, spare textures, and memory the allocator is holding on to.
+    Trim,
+    Quit,
+}
+
+/// Removes `--skua-pipe`, `--skua-parent` and `--skua-movie` from `args`. Returns the movie
+/// to play when Skua started this process.
+pub fn take_args(args: &mut Vec<OsString>) -> Option<OsString> {
+    let mut pipe = None;
+    let mut parent = None;
+    let mut movie = None;
+    let mut rest = Vec::with_capacity(args.len());
+    let mut iter = std::mem::take(args).into_iter();
+    while let Some(arg) = iter.next() {
+        let text = arg.to_string_lossy().to_string();
+        let (flag, inline) = match text.split_once('=') {
+            Some((flag, value)) if flag.starts_with("--skua-") => (flag.to_string(), Some(value.to_string())),
+            _ => (text.clone(), None),
+        };
+        let slot = match flag.as_str() {
+            "--skua-pipe" => &mut pipe,
+            "--skua-parent" => &mut parent,
+            "--skua-movie" => &mut movie,
+            _ => {
+                rest.push(arg);
+                continue;
+            }
+        };
+        *slot = match inline {
+            Some(value) => Some(OsString::from(value)),
+            None => iter.next(),
+        };
+    }
+    *args = rest;
+
+    let pipe = pipe?.to_string_lossy().to_string();
+    let parent = parent.and_then(|p| {
+        let p = p.to_string_lossy();
+        let p = p.trim();
+        match p.strip_prefix("0x") {
+            Some(hex) => isize::from_str_radix(hex, 16).ok(),
+            None => p.parse::<isize>().ok(),
+        }
+    });
+    let _ = CONFIG.set(Config { pipe, parent });
+    Some(movie.unwrap_or_else(|| OsString::from("skua.swf")))
+}
+
+pub fn enabled() -> bool {
+    CONFIG.get().is_some()
+}
+
+static LOG_DIR: OnceLock<PathBuf> = OnceLock::new();
+
+/// Skua mode runs several players at once; sharing Mugetsu's single ruffle.log makes them overwrite
+/// each other's lines (a crash's details got lost that way). Each player gets its own
+/// `skua-<time>-<pid>.log`; ones older than three days are removed.
+pub fn log_path(dir: &std::path::Path) -> Option<PathBuf> {
+    if !enabled() {
+        return None;
+    }
+    let _ = LOG_DIR.set(dir.to_path_buf());
+    if let Ok(entries) = std::fs::read_dir(dir) {
+        let cutoff = std::time::SystemTime::now() - Duration::from_secs(3 * 24 * 3600);
+        for entry in entries.flatten() {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            // Crash reports are kept two weeks, other logs three days.
+            let keep_until = if name.starts_with("skua-crash-") {
+                cutoff - Duration::from_secs(11 * 24 * 3600)
+            } else {
+                cutoff
+            };
+            if name.starts_with("skua-") && name.ends_with(".log")
+                && entry.metadata().and_then(|m| m.modified()).is_ok_and(|t| t < keep_until)
+            {
+                let _ = std::fs::remove_file(entry.path());
+            }
+        }
+    }
+    Some(dir.join(format!(
+        "skua-{}-{}.log",
+        chrono::Utc::now().format("%Y%m%d-%H%M%S"),
+        std::process::id()
+    )))
+}
+
+/// Skua mode: the log file a player writes to, capped so week-long runs can't fill the disk. Past the cap
+/// (25 MB, `SKUA_LOG_CAP_MB` to change) the file is renamed to `*-prev.log` (replacing an older one) and
+/// a new one is started.
+pub struct CappedLog {
+    path: PathBuf,
+    file: Option<File>,
+    written: u64,
+    cap: u64,
+}
+
+impl CappedLog {
+    pub fn create(path: &std::path::Path) -> std::io::Result<Self> {
+        let cap_mb = std::env::var("SKUA_LOG_CAP_MB")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .filter(|&mb| mb > 0)
+            .unwrap_or(25);
+        Ok(Self {
+            path: path.to_path_buf(),
+            file: Some(File::create(path)?),
+            written: 0,
+            cap: cap_mb << 20,
+        })
+    }
+
+    fn rotate(&mut self) -> std::io::Result<()> {
+        self.file = None; // close it so it can be renamed
+        let prev = self.path.with_file_name(format!(
+            "{}-prev.log",
+            self.path.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default()
+        ));
+        let _ = std::fs::remove_file(&prev);
+        let _ = std::fs::rename(&self.path, &prev);
+        self.file = Some(File::create(&self.path)?);
+        self.written = 0;
+        Ok(())
+    }
+}
+
+impl Write for CappedLog {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        if self.written + buf.len() as u64 > self.cap {
+            self.rotate()?;
+        }
+        let file = match self.file.as_mut() {
+            Some(file) => file,
+            None => return Ok(buf.len()),
+        };
+        let n = file.write(buf)?;
+        self.written += n as u64;
+        Ok(n)
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.file.as_mut().map_or(Ok(()), |f| f.flush())
+    }
+}
+
+/// Writes crash details straight to their own file. The normal log is written in the background and
+/// the crash handler ends the process right away, so its last lines can be lost.
+pub fn write_crash(details: &str) {
+    if let Some(dir) = LOG_DIR.get() {
+        let path = dir.join(format!(
+            "skua-crash-{}-{}.log",
+            chrono::Utc::now().format("%Y%m%d-%H%M%S"),
+            std::process::id()
+        ));
+        let _ = std::fs::write(path, details);
+    }
+}
+
+pub fn parent() -> Option<isize> {
+    CONFIG.get().and_then(|c| c.parent)
+}
+
+/// Skua asked for no drawing at all (the game keeps running).
+pub fn headless() -> bool {
+    HEADLESS.load(Ordering::Relaxed)
+}
+
+pub fn set_headless(on: bool) {
+    HEADLESS.store(on, Ordering::Relaxed);
+}
+
+fn pipe_path(name: &str, direction: &str) -> PathBuf {
+    if cfg!(windows) {
+        PathBuf::from(format!(r"\\.\pipe\{name}-{direction}"))
+    } else {
+        // For testing on Linux/macOS: two FIFOs (mkfifo) in the temp directory.
+        std::env::temp_dir().join(format!("{name}-{direction}"))
+    }
+}
+
+/// Opens one end of a pipe Skua created, retrying while Skua is still setting it up.
+fn open_pipe(path: &PathBuf, write: bool) -> std::io::Result<File> {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        let result = if write {
+            OpenOptions::new().write(true).open(path)
+        } else {
+            OpenOptions::new().read(true).open(path)
+        };
+        match result {
+            Ok(file) => return Ok(file),
+            Err(e) if Instant::now() < deadline => {
+                tracing::debug!("Skua pipe {} not ready yet: {e}", path.display());
+                std::thread::sleep(Duration::from_millis(50));
+            }
+            Err(e) => return Err(e),
+        }
+    }
+}
+
+/// Connects to Skua's pipes and starts the reader and writer threads. `hwnd` is this
+/// window's handle, sent to Skua so it can size the window inside its panel.
+pub fn start(proxy: EventLoopProxy<RuffleEvent>, hwnd: Option<isize>) {
+    let Some(config) = CONFIG.get() else {
+        return;
+    };
+    let (sender, receiver) = mpsc::channel::<Vec<u8>>();
+    if OUTBOX.set(sender).is_err() {
+        return; // Already started.
+    }
+
+    let write_path = pipe_path(&config.pipe, "r2c");
+    std::thread::Builder::new()
+        .name("skua-pipe-writer".into())
+        .spawn(move || {
+            let file = match open_pipe(&write_path, true) {
+                Ok(file) => file,
+                Err(e) => {
+                    tracing::error!("Couldn't open Skua pipe {}: {e}", write_path.display());
+                    return;
+                }
+            };
+            let mut writer = BufWriter::with_capacity(64 * 1024, file);
+            while let Ok(first) = receiver.recv() {
+                let mut message = Some(first);
+                // Write everything queued, then flush once.
+                while let Some(bytes) = message.take() {
+                    let length = (bytes.len() as u32).to_le_bytes();
+                    if writer.write_all(&length).and_then(|_| writer.write_all(&bytes)).is_err() {
+                        return;
+                    }
+                    message = receiver.try_recv().ok();
+                }
+                if writer.flush().is_err() {
+                    return;
+                }
+            }
+        })
+        .expect("Skua writer thread");
+
+    send(json!({ "t": "hello", "hwnd": hwnd, "pid": std::process::id() }));
+
+    let read_path = pipe_path(&config.pipe, "c2r");
+    std::thread::Builder::new()
+        .name("skua-pipe-reader".into())
+        .spawn(move || {
+            let file = match open_pipe(&read_path, false) {
+                Ok(file) => file,
+                Err(e) => {
+                    tracing::error!("Couldn't open Skua pipe {}: {e}", read_path.display());
+                    let _ = proxy.send_event(RuffleEvent::ExitRequested);
+                    return;
+                }
+            };
+            let mut reader = BufReader::with_capacity(64 * 1024, file);
+            loop {
+                let mut length = [0u8; 4];
+                if reader.read_exact(&mut length).is_err() {
+                    break;
+                }
+                let mut bytes = vec![0u8; u32::from_le_bytes(length) as usize];
+                if reader.read_exact(&mut bytes).is_err() {
+                    break;
+                }
+                let request = match serde_json::from_slice::<Json>(&bytes) {
+                    Ok(message) => parse_request(message),
+                    Err(e) => {
+                        tracing::warn!("Bad message from Skua: {e}");
+                        continue;
+                    }
+                };
+                if let Some(request) = request
+                    && proxy.send_event(RuffleEvent::Skua(request)).is_err()
+                {
+                    return;
+                }
+            }
+            // Skua closed the pipe (exited or crashed): close the game with it.
+            tracing::info!("Skua disconnected; exiting");
+            let _ = proxy.send_event(RuffleEvent::ExitRequested);
+        })
+        .expect("Skua reader thread");
+}
+
+fn parse_request(message: Json) -> Option<Request> {
+    match message.get("t")?.as_str()? {
+        "call" => Some(Request::Call {
+            id: message.get("id")?.as_u64()?,
+            name: message.get("n")?.as_str()?.to_string(),
+            args: message
+                .get("a")
+                .and_then(Json::as_array)
+                .map(|args| args.iter().map(from_json).collect())
+                .unwrap_or_default(),
+        }),
+        "headless" => Some(Request::Headless(
+            message.get("on").and_then(Json::as_bool).unwrap_or(false),
+        )),
+        "refresh" => Some(Request::Refresh),
+        "trim" => Some(Request::Trim),
+        "quit" => Some(Request::Quit),
+        other => {
+            tracing::warn!("Unknown message from Skua: {other}");
+            None
+        }
+    }
+}
+
+fn send(message: Json) {
+    if let Some(outbox) = OUTBOX.get()
+        && let Ok(bytes) = serde_json::to_vec(&message)
+    {
+        let _ = outbox.send(bytes);
+    }
+}
+
+/// The result of a call Skua made.
+pub fn reply(id: u64, value: &Value) {
+    send(json!({ "t": "ret", "id": id, "v": to_json(value) }));
+}
+
+pub fn to_json(value: &Value) -> Json {
+    match value {
+        Value::Undefined => json!({ "$u": 1 }),
+        Value::Null => Json::Null,
+        Value::Bool(b) => Json::Bool(*b),
+        Value::Number(n) => match Number::from_f64(*n) {
+            Some(number) => Json::Number(number),
+            None => {
+                let name = if n.is_nan() {
+                    "NaN"
+                } else if *n > 0.0 {
+                    "Infinity"
+                } else {
+                    "-Infinity"
+                };
+                json!({ "$n": name })
+            }
+        },
+        Value::String(s) => Json::String(s.clone()),
+        Value::List(list) => Json::Array(list.iter().map(to_json).collect()),
+        Value::Object(map) => {
+            let inner: Map<String, Json> =
+                map.iter().map(|(k, v)| (k.clone(), to_json(v))).collect();
+            json!({ "$o": inner })
+        }
+    }
+}
+
+pub fn from_json(json: &Json) -> Value {
+    match json {
+        Json::Null => Value::Null,
+        Json::Bool(b) => Value::Bool(*b),
+        Json::Number(n) => Value::Number(n.as_f64().unwrap_or(f64::NAN)),
+        Json::String(s) => Value::String(s.clone()),
+        Json::Array(list) => Value::List(list.iter().map(from_json).collect()),
+        Json::Object(map) => {
+            if map.contains_key("$u") {
+                return Value::Undefined;
+            }
+            if let Some(special) = map.get("$n").and_then(Json::as_str) {
+                return Value::Number(match special {
+                    "Infinity" => f64::INFINITY,
+                    "-Infinity" => f64::NEG_INFINITY,
+                    _ => f64::NAN,
+                });
+            }
+            let fields = map.get("$o").and_then(Json::as_object).unwrap_or(map);
+            Value::Object(
+                fields
+                    .iter()
+                    .map(|(k, v)| (k.clone(), from_json(v)))
+                    .collect::<BTreeMap<_, _>>(),
+            )
+        }
+    }
+}
