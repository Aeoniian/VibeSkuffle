+
+    // ---- Health check (week-long runs) ----------------------------------------------------------------
+    // Every 30 s: a quick call to the game. Three unanswered in a row (about a minute and a half
+    // frozen) and the game window is restarted; the login watchdog then logs back in and restarts the
+    // script. Also a memory safety net: past SKUA_MEMORY_LIMIT_MB (ruffle-options.txt, default 6000)
+    // the window is restarted once the account is out of combat (or after 10 minutes regardless).
+
+    private System.Threading.Timer? _healthTimer;
+    private int _healthBusy;
+    private int _missedBeats;
+    private DateTime _overLimitSince = DateTime.MinValue;
+    private DateTime _lastMemoryRestart = DateTime.MinValue;
+    private bool _loggedTooSoon;
+    private static long _memoryLimitMb = 6000;
+
+    private void StartHealthTimer()
+    {
+        _healthTimer ??= new System.Threading.Timer(_ => HealthTick(), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(30));
+    }
+
+    private void HealthTick()
+    {
+        if (_disposed || Interlocked.Exchange(ref _healthBusy, 1) == 1)
+            return;
+        try
+        {
+            Session? session = _session;
+            if (session is null || !session.Connected.IsSet || session.Process is not { } process || process.HasExited)
+                return;
+
+            if (Ping(session, TimeSpan.FromSeconds(15)))
+            {
+                _missedBeats = 0;
+            }
+            else if (++_missedBeats >= 3)
+            {
+                _missedBeats = 0;
+                HealthLog(" the game window stopped answering (frozen for over a minute); restarting it.");
+                KillPlayer(session);
+                return;
+            }
+
+            process.Refresh();
+            long committedMb = process.PrivateMemorySize64 >> 20;
+            // Also when the whole PC is running out of memory: the biggest game window goes first.
+            long freeMb = FreeRamMb(out long totalMb);
+            bool pcLow = totalMb > 0 && (freeMb < totalMb / 10 || freeMb < 1500)
+                && committedMb >= 2500 && IsBiggestGameWindow(process, committedMb);
+            if (committedMb <= _memoryLimitMb && !pcLow)
+            {
+                _overLimitSince = DateTime.MinValue;
+                return;
+            }
+            if (_overLimitSince == DateTime.MinValue)
+                _overLimitSince = DateTime.UtcNow;
+            bool inCombat = false;
+            try { inCombat = CommunityToolkit.Mvvm.DependencyInjection.Ioc.Default.GetService<IScriptPlayer>()?.InCombat ?? false; } catch { }
+            // A limit set lower than the game needs would restart it over and over: at most once per 30 minutes.
+            if (DateTime.UtcNow - _lastMemoryRestart < TimeSpan.FromMinutes(30))
+            {
+                if (!_loggedTooSoon)
+                    HealthLog($" the game window uses {committedMb} MB (limit {_memoryLimitMb} MB), but it was restarted for memory less than 30 minutes ago; waiting. If this keeps happening, raise SKUA_MEMORY_LIMIT_MB.");
+                _loggedTooSoon = true;
+                return;
+            }
+            if (!inCombat || DateTime.UtcNow - _overLimitSince > TimeSpan.FromMinutes(10))
+            {
+                _overLimitSince = DateTime.MinValue;
+                _lastMemoryRestart = DateTime.UtcNow;
+                _loggedTooSoon = false;
+                HealthLog(committedMb > _memoryLimitMb
+                    ? $" the game window uses {committedMb} MB (limit {_memoryLimitMb} MB); restarting it."
+                    : $" the PC is low on memory ({freeMb} MB of {totalMb} MB free) and this is the biggest game window ({committedMb} MB); restarting it.");
+                KillPlayer(session);
+            }
+        }
+        catch (Exception ex)
+        {
+            Trace.WriteLine($"Ruffle health check: {ex.Message}");
+        }
+        finally
+        {
+            _healthBusy = 0;
+        }
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct MemoryStatusEx
+    {
+        public uint dwLength, dwMemoryLoad;
+        public ulong ullTotalPhys, ullAvailPhys, ullTotalPageFile, ullAvailPageFile, ullTotalVirtual, ullAvailVirtual, ullAvailExtendedVirtual;
+    }
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool GlobalMemoryStatusEx(ref MemoryStatusEx status);
+
+    private static long FreeRamMb(out long totalMb)
+    {
+        var status = new MemoryStatusEx { dwLength = (uint)Marshal.SizeOf<MemoryStatusEx>() };
+        if (!GlobalMemoryStatusEx(ref status))
+        {
+            totalMb = 0;
+            return 0;
+        }
+        totalMb = (long)(status.ullTotalPhys >> 20);
+        return (long)(status.ullAvailPhys >> 20);
+    }
+
+    /// <summary>Whether this is the biggest of this install's game windows (so only one restarts at a time).</summary>
+    private static bool IsBiggestGameWindow(Process mine, long mineMb)
+    {
+        try
+        {
+            string? folder = Path.GetDirectoryName(mine.MainModule?.FileName);
+            foreach (Process other in Process.GetProcessesByName(mine.ProcessName))
+            {
+                using (other)
+                {
+                    if (other.Id == mine.Id)
+                        continue;
+                    try
+                    {
+                        if (folder != null && !string.Equals(Path.GetDirectoryName(other.MainModule?.FileName), folder, StringComparison.OrdinalIgnoreCase))
+                            continue;
+                        long otherMb = other.PrivateMemorySize64 >> 20;
+                        if (otherMb > mineMb || (otherMb == mineMb && other.Id < mine.Id))
+                            return false;
+                    }
+                    catch { }
+                }
+            }
+            return true;
+        }
+        catch
+        {
+            return false;
+        }
+    }
+
+    /// <summary>A call with its own timeout: true if the game answered at all.</summary>
+    private bool Ping(Session session, TimeSpan timeout)
+    {
+        long id = Interlocked.Increment(ref _nextId);
+        var call = new PendingCall(session);
+        _pending[id] = call;
+        var request = new JObject { ["t"] = "call", ["id"] = id, ["n"] = "isTrue", ["a"] = new JArray() };
+        bool answered = Send(session, request) && call.Done.Wait(timeout);
+        _pending.TryRemove(id, out _);
+        return answered;
+    }
