index 0000000..437f8a9
--- /dev/null
+++ b/Skua.App.Avalonia/Views/UiProfileLauncher.cs
@@ -0,0 +1,30 @@
+// Test controls only; excluded from all configurations except UI_PROFILE.
+using Avalonia.Controls;
+using Avalonia.Layout;
+using Avalonia.Threading;
+using CommunityToolkit.Mvvm.DependencyInjection;
+using Skua.Core.Interfaces;
+using System;
+
+namespace Skua.App.Avalonia.Views;
+
+internal static class UiProfileLauncher
+{
+    public static void Attach(Window owner)
+    {
+        owner.Opened += (_, _) => Dispatcher.UIThread.Post(() =>
+        {
+            var panel = new StackPanel { Spacing = 6, Margin = new global::Avalonia.Thickness(12) };
+            panel.Children.Add(new TextBlock { Text = "Profiling only: opens existing screens. No script execution." });
+            foreach (var key in new[] { "Script Loader", "Script Repo", "Game", "Watch Dog", "Grabber", "Loader", "Logger", "Interceptor", "Application" })
+            {
+                var button = new Button { Content = key == "Script Repo" ? "Search Scripts" : key, HorizontalAlignment = HorizontalAlignment.Stretch };
+                button.Click += (_, _) => Ioc.Default.GetRequiredService<IWindowService>().ShowManagedWindow(key);
+                panel.Children.Add(button);
+            }
+            var window = new Window { Title = "UI profiling controls", Width = 470, Height = 470, Content = panel, ShowInTaskbar = true };
+            window.Show();
+            owner.Closed += (_, _) => window.Close();
+        });
+    }
+}
diff --git a/Skua.App.Avalonia/Views/UiStallProfiler.cs b/Skua.App.Avalonia/Views/UiStallProfiler.cs
new file mode 100644
index 0000000..cad9570
--- /dev/null
+++ b/Skua.App.Avalonia/Views/UiStallProfiler.cs
@@ -0,0 +1,168 @@
+// Included only in the UI_PROFILE build. Log fields are fixed categories and timings;
+// never include account names, menu text, script paths, or arbitrary control content.
+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Input;
+using Avalonia.Interactivity;
+using Avalonia.Threading;
+using Avalonia.VisualTree;
+using System;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Skua.App.Avalonia.Views;
+
+internal sealed class UiStallProfiler
+{
+    private static UiStallProfiler? _current;
+    private readonly Window _window;
+    private readonly string _role;
+    private readonly ConcurrentQueue<string> _lines = new();
+    private readonly ConcurrentQueue<string> _operations = new();
+    private readonly CancellationTokenSource _stop = new();
+    private readonly string _logFile;
+    private string _lastAction = "idle";
+    private long _lastActionTimestamp;
+    private int _pendingPing;
+    private long _completedPings;
+
+    private UiStallProfiler(Window window, string role)
+    {
+        _window = window;
+        _role = role;
+        _logFile = Path.Combine(AppContext.BaseDirectory, "ui-profile", $"{role}-{Environment.ProcessId}.csv");
+    }
+
+    public static void Start(Window window, string role)
+    {
+        var profiler = new UiStallProfiler(window, role);
+        _current = profiler;
+        var opened = Window.WindowOpenedEvent.AddClassHandler<Window>((w, _) => profiler.TrackWindow(w));
+        profiler.TrackWindow(window);
+        window.Closed += (_, _) => { opened.Dispose(); profiler._stop.Cancel(); };
+        // The producer must not capture the UI synchronization context: otherwise
+        // a blocked UI would also stop the producer and conceal the delay.
+        _ = Task.Run(profiler.RunAsync);
+    }
+
+    private void TrackWindow(Window window)
+    {
+        Mark(Classify(window, _role));
+        window.AddHandler(InputElement.PointerPressedEvent, OnPointerPressed,
+            RoutingStrategies.Tunnel, handledEventsToo: true);
+    }
+
+    private void Mark(string category)
+    {
+        Volatile.Write(ref _lastAction, category);
+        Volatile.Write(ref _lastActionTimestamp, Stopwatch.GetTimestamp());
+    }
+
+    public static IDisposable Measure(string name, string stage)
+    {
+        var label = KnownLabel(name) ?? "other";
+        _current?.Mark(label);
+        return new Operation(_current, label, stage);
+    }
+
+    private sealed class Operation(UiStallProfiler? profiler, string category, string stage) : IDisposable
+    {
+        private readonly long _started = Stopwatch.GetTimestamp();
+        public void Dispose()
+        {
+            profiler?._operations.Enqueue($"{DateTime.UtcNow:O},{category},{stage},{Stopwatch.GetElapsedTime(_started).TotalMilliseconds:F2}");
+        }
+    }
+
+    private static string? KnownLabel(string? name) => name switch
+    {
+        "Script Loader" or "Scripts" or "ScriptLoaderViewModel" => "Script Loader",
+        "Script Repo" or "Search Scripts" or "ScriptRepoViewModel" => "Search Scripts",
+        "Game" or "Game Options" or "GameOptionsViewModel" => "Game Options",
+        "Watch Dog" or "WatchDogViewModel" => "Watch Dog",
+        "Grabber" or "GrabberViewModel" => "Grabber",
+        "Logger" or "Packet Logger" or "PacketLoggerViewModel" => "Packet Logger",
+        "Interceptor" or "PacketInterceptorViewModel" => "Packet Interceptor",
+        "Spammer" or "PacketSpammerViewModel" => "Packet Spammer",
+        "Loader" or "LoaderViewModel" => "Loader",
+        "Application" or "Application Options" or "ApplicationOptionsViewModel" => "Application Options",
+        _ => null
+    };
+
+    private void OnPointerPressed(object? sender, PointerPressedEventArgs e)
+    {
+        Mark(Classify(e.Source, _role));
+    }
+
+    private static string Classify(object? source, string role)
+    {
+        if (source is not Visual visual)
+            return role;
+
+        var ancestors = visual.GetVisualAncestors().Prepend(visual).ToArray();
+        foreach (var control in ancestors.OfType<Control>())
+        {
+            var label = control is MenuItem menu ? KnownLabel(menu.Header as string) : null;
+            label ??= KnownLabel(control.DataContext?.GetType().Name);
+            if (control is Window window) label ??= KnownLabel(window.Title);
+            if (label is not null) return label;
+        }
+        var names = ancestors
+            .Select(v => v.GetType().Name).ToArray();
+        if (names.Any(n => n.Contains("ScriptLoader", StringComparison.OrdinalIgnoreCase))) return "Script Loader";
+        if (names.Any(n => n.Contains("WatchDog", StringComparison.OrdinalIgnoreCase))) return "Watch Dog";
+        if (names.Any(n => n.Contains("Packet", StringComparison.OrdinalIgnoreCase))) return "Packet tools";
+        if (names.Any(n => n.Contains("Grabber", StringComparison.OrdinalIgnoreCase))) return "Grabber";
+        if (names.Any(n => n.Contains("Bank", StringComparison.OrdinalIgnoreCase))) return "Bank/Inventory";
+        if (names.Any(n => n.Contains("Inventory", StringComparison.OrdinalIgnoreCase))) return "Bank/Inventory";
+        if (names.Any(n => n.Contains("Options", StringComparison.OrdinalIgnoreCase))) return "Options";
+        if (names.Any(n => n.Contains("TabControl", StringComparison.OrdinalIgnoreCase))) return "Tabs";
+        if (names.Any(n => n.Contains("MenuItem", StringComparison.OrdinalIgnoreCase))) return "Menu";
+        return role;
+    }
+
+    private async Task RunAsync()
+    {
+        try
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(_logFile)!);
+            await File.WriteAllTextAsync(_logFile, "utc,role,category,delay_ms,action_age_ms\n", _stop.Token);
+            await File.WriteAllTextAsync(_logFile + ".operations.csv", "utc,category,stage,duration_ms\n", _stop.Token);
+            while (!_stop.IsCancellationRequested)
+            {
+                await Task.Delay(100, _stop.Token);
+                if (Interlocked.CompareExchange(ref _pendingPing, 1, 0) != 0)
+                    continue;
+                var posted = Stopwatch.GetTimestamp();
+                Dispatcher.UIThread.Post(() =>
+                {
+                    Interlocked.Exchange(ref _pendingPing, 0);
+                    Interlocked.Increment(ref _completedPings);
+                    if (_stop.IsCancellationRequested || !_window.IsVisible) return;
+                    var now = Stopwatch.GetTimestamp();
+                    var delayMs = Stopwatch.GetElapsedTime(posted, now).TotalMilliseconds;
+                    if (delayMs <= 50) return;
+                    var actionAgeMs = Stopwatch.GetElapsedTime(
+                        Volatile.Read(ref _lastActionTimestamp), now).TotalMilliseconds;
+                    var category = actionAgeMs <= 5000 ? Volatile.Read(ref _lastAction) : "idle";
+                    _lines.Enqueue($"{DateTime.UtcNow:O},{_role},{category},{delayMs:F2},{actionAgeMs:F0}");
+                }, DispatcherPriority.Send);
+
+                while (_lines.TryDequeue(out var line))
+                    await File.AppendAllTextAsync(_logFile, line + "\n", _stop.Token);
+                while (_operations.TryDequeue(out var operation))
+                    await File.AppendAllTextAsync(_logFile + ".operations.csv", operation + "\n", _stop.Token);
+                if (Interlocked.Read(ref _completedPings) % 10 == 0)
+                    await File.WriteAllTextAsync(_logFile + ".health",
+                        $"completed_pings={Interlocked.Read(ref _completedPings)}\n", _stop.Token);
+            }
+        }
+        catch (OperationCanceledException) { }
+        catch (IOException) { }
+        catch (UnauthorizedAccessException) { }
+    }
+}
