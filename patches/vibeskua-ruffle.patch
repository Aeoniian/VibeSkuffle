@@ -0,0 +1,35 @@
+using System;
+using System.IO;
+using System.Linq;
+
+namespace Skua.App.Avalonia.Flash;
+
+/// <summary>
+/// Picks the game player: the Flash ActiveX control (default) or Ruffle.
+/// Ruffle is used when Skua is started with <c>--ruffle</c>, or when a file named <c>use-ruffle</c>
+/// (or <c>use-ruffle.txt</c>) sits next to Skua's exe; <c>--flash</c> forces Flash.
+/// </summary>
+public static class FlashBackend
+{
+    private static readonly Lazy<bool> _useRuffle = new(() =>
+    {
+        string[] args = Environment.GetCommandLineArgs();
+        if (args.Any(a => a.Equals("--flash", StringComparison.OrdinalIgnoreCase)))
+            return false;
+        if (args.Any(a => a.Equals("--ruffle", StringComparison.OrdinalIgnoreCase)))
+            return true;
+        string dir = AppContext.BaseDirectory;
+        return File.Exists(Path.Combine(dir, "use-ruffle")) || File.Exists(Path.Combine(dir, "use-ruffle.txt"));
+    });
+
+    public static bool UseRuffle => OperatingSystem.IsWindows() && _useRuffle.Value;
+
+    /// <summary>
+    /// Name of the tab host's mutex and pipe. The Ruffle build uses its own, so it runs next to a normal
+    /// (Flash) VibeSkua instead of handing its tabs over to it.
+    /// </summary>
+    public static string TabHostMutexName => UseRuffle ? "VibeSkuaRuffleTabHostMutex" : "VibeSkuaTabHostMutex";
+
+    /// <inheritdoc cref="TabHostMutexName"/>
+    public static string TabHostPipeName => UseRuffle ? "VibeSkuaRuffleTabHostPipe" : "VibeSkuaTabHostPipe";
+}
diff --git a/Skua.App.Avalonia/Flash/RuffleControl.cs b/Skua.App.Avalonia/Flash/RuffleControl.cs
new file mode 100644
index 0000000..4d95294
--- /dev/null
+++ b/Skua.App.Avalonia/Flash/RuffleControl.cs
@@ -0,0 +1,140 @@
+namespace Skua.App.Avalonia.Flash;
+
+#if IS_WINDOWS
+using System;
+using System.Runtime.InteropServices;
+using WinForms = System.Windows.Forms;
+
+/// <summary>
+/// The panel the Ruffle game window lives in. Ruffle creates its window as a child of this control
+/// (it gets <see cref="WinForms.Control.Handle"/> on its command line); this control keeps it sized
+/// to fill the panel.
+/// </summary>
+public sealed class RuffleControl : WinForms.Control
+{
+    private IntPtr _game;
+    private readonly WinForms.Timer _watch = new() { Interval = 500 };
+    private bool _wasShowing;
+
+    /// <summary>
+    /// Raised when the panel becomes visible again: the window was restored from the taskbar or its tab
+    /// was shown. The game window doesn't always notice that itself, so Ruffle is told to draw again.
+    /// </summary>
+    public event Action? ShownAgain;
+
+    public RuffleControl()
+    {
+        BackColor = System.Drawing.Color.FromArgb(20, 20, 20);
+        SetStyle(WinForms.ControlStyles.Opaque | WinForms.ControlStyles.UserPaint, true);
+        TabStop = true;
+        _watch.Tick += (_, _) => CheckShowing();
+    }
+
+    private void CheckShowing()
+    {
+        if (!IsHandleCreated)
+            return;
+        IntPtr root = GetAncestor(Handle, GA_ROOT);
+        bool showing = IsWindowVisible(Handle) && (root == IntPtr.Zero || !IsIconic(root))
+                       && ClientSize.Width > 1 && ClientSize.Height > 1;
+        if (showing && !_wasShowing)
+        {
+            FitGameWindow();
+            ShownAgain?.Invoke();
+        }
+        _wasShowing = showing;
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing)
+            _watch.Dispose();
+        base.Dispose(disposing);
+    }
+
+    /// <summary>Called (from any thread) once Ruffle reports its window, or with zero when it goes away.</summary>
+    public void SetGameWindow(IntPtr hwnd)
+    {
+        _game = hwnd;
+        if (hwnd == IntPtr.Zero || !IsHandleCreated)
+            return;
+        try
+        {
+            BeginInvoke(new Action(FitGameWindow));
+        }
+        catch (InvalidOperationException)
+        {
+            // Handle went away meanwhile.
+        }
+    }
+
+    protected override void OnHandleCreated(EventArgs e)
+    {
+        base.OnHandleCreated(e);
+        FitGameWindow();
+        _watch.Start();
+    }
+
+    protected override void OnResize(EventArgs e)
+    {
+        base.OnResize(e);
+        FitGameWindow();
+    }
+
+    protected override void OnGotFocus(EventArgs e)
+    {
+        base.OnGotFocus(e);
+        // Pass keyboard focus on to the game.
+        if (_game != IntPtr.Zero && IsWindow(_game))
+            SetFocus(_game);
+    }
+
+    private void FitGameWindow()
+    {
+        IntPtr game = _game;
+        if (game == IntPtr.Zero || !IsWindow(game))
+            return;
+        // Asynchronous: Ruffle's thread may be busy with a frame; don't block Skua's UI on it.
+        SetWindowPos(game, IntPtr.Zero, 0, 0, Math.Max(1, ClientSize.Width), Math.Max(1, ClientSize.Height),
+            SWP_NOZORDER | SWP_NOACTIVATE | SWP_ASYNCWINDOWPOS | SWP_SHOWWINDOW);
+    }
+
+    protected override void OnPaintBackground(WinForms.PaintEventArgs pevent)
+    {
+        // The game window covers everything; only paint while there is none.
+        if (_game == IntPtr.Zero)
+            base.OnPaintBackground(pevent);
+    }
+
+    protected override void OnPaint(WinForms.PaintEventArgs e)
+    {
+        if (_game == IntPtr.Zero)
+            e.Graphics.Clear(BackColor);
+    }
+
+    private const uint SWP_NOZORDER = 0x0004;
+    private const uint SWP_NOACTIVATE = 0x0010;
+    private const uint SWP_SHOWWINDOW = 0x0040;
+    private const uint SWP_ASYNCWINDOWPOS = 0x4000;
+
+    [DllImport("user32.dll", SetLastError = true)]
+    private static extern bool SetWindowPos(IntPtr hWnd, IntPtr hWndInsertAfter, int x, int y, int cx, int cy, uint flags);
+
+    [DllImport("user32.dll")]
+    private static extern bool IsWindow(IntPtr hWnd);
+
+    [DllImport("user32.dll")]
+    private static extern bool IsWindowVisible(IntPtr hWnd);
+
+    [DllImport("user32.dll")]
+    private static extern bool IsIconic(IntPtr hWnd);
+
+    [DllImport("user32.dll")]
+    private static extern IntPtr GetAncestor(IntPtr hWnd, uint flags);
+
+    private const uint GA_ROOT = 2;
+
+    [DllImport("user32.dll")]
+    private static extern IntPtr SetFocus(IntPtr hWnd);
+}
+#endif
diff --git a/Skua.App.Avalonia/Flash/RuffleFlashUtil.cs b/Skua.App.Avalonia/Flash/RuffleFlashUtil.cs
new file mode 100644
index 0000000..90d0ed0
--- /dev/null
+++ b/Skua.App.Avalonia/Flash/RuffleFlashUtil.cs
@@ -0,0 +1,982 @@
+using Skua.Core.Interfaces;
+using System;
+using System.Xml.Linq;
+
+namespace Skua.App.Avalonia.Flash;
+
+#if IS_WINDOWS
+using Dispatcher = global::Avalonia.Threading.Dispatcher;
+using CommunityToolkit.Mvvm.Messaging;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using Skua.Core.Flash;
+using Skua.Core.Messaging;
+using Skua.Core.Utils;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Dynamic;
+using System.Globalization;
+using System.IO;
+using System.IO.Pipes;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using WinForms = System.Windows.Forms;
+
+/// <summary>
+/// <see cref="IFlashUtil"/> backed by a Ruffle process (Mugetsu build with the Skua bridge) instead of
+/// the Flash ActiveX control. Ruffle draws inside a <see cref="RuffleControl"/> as a child window and
+/// talks to Skua over two named pipes; see <c>skua.rs</c> in the Ruffle patch for the protocol.
+/// </summary>
+/// <remarks>
+/// Behaves like <see cref="FlashUtil"/> towards the rest of Skua: <see cref="Call(string, Type, object[])"/>
+/// blocks until the movie answers, and <see cref="FlashCall"/> is raised on the UI thread, in order.
+/// </remarks>
+public sealed class RuffleFlashUtil : IFlashUtil, IRestartableGamePlayer
+{
+    /// <summary>Longest a call waits for the game before giving up and returning the default value.</summary>
+    private static readonly TimeSpan CallTimeout = TimeSpan.FromSeconds(20);
+
+    /// <summary>Longest a call made before Ruffle has connected waits for it.</summary>
+    private static readonly TimeSpan ConnectTimeout = TimeSpan.FromSeconds(30);
+
+
+    private readonly IMessenger _messenger;
+    private readonly Lazy<IScriptManager> _lazyManager;
+
+    private readonly object _writeLock = new();
+    private readonly ConcurrentDictionary<long, PendingCall> _pending = new();
+    private long _nextId;
+
+    private Session? _session;
+    private RuffleControl? _control;
+    private Thread? _uiThread;
+    private bool _headless;
+    private bool _disposed;
+    private DateTime _lastRestart = DateTime.MinValue;
+
+    public event FlashCallHandler? FlashCall;
+
+    public RuffleFlashUtil(IMessenger messenger, Lazy<IScriptManager> manager)
+    {
+        _messenger = messenger;
+        _lazyManager = manager;
+    }
+
+    /// <summary>The Ruffle executable: <c>ruffle\Mugetsu.exe</c> next to Skua, or <c>SKUA_RUFFLE_EXE</c>.</summary>
+    public static string RuffleExePath =>
+        Environment.GetEnvironmentVariable("SKUA_RUFFLE_EXE") is { Length: > 0 } custom
+            ? custom
+            : Path.Combine(AppContext.BaseDirectory, "ruffle", "Mugetsu.exe");
+
+    public void InitializeFlash()
+    {
+        string swfPath = Path.Combine(AppContext.BaseDirectory, "skua.swf");
+        if (!File.Exists(swfPath))
+        {
+            WinForms.MessageBox.Show("Missing skua.swf. Build the AS3 client first.", "Missing game content",
+                WinForms.MessageBoxButtons.OK, WinForms.MessageBoxIcon.Exclamation);
+            Environment.Exit(0);
+            return;
+        }
+
+        string exe = RuffleExePath;
+        if (!File.Exists(exe))
+        {
+            WinForms.MessageBox.Show($"Ruffle mode is on, but the Ruffle player wasn't found at:\r\n{exe}\r\n\r\n" +
+                "Build it with build-ruffle.bat, or delete use-ruffle.txt to go back to Flash.", "Ruffle missing",
+                WinForms.MessageBoxButtons.OK, WinForms.MessageBoxIcon.Exclamation);
+            Environment.Exit(0);
+            return;
+        }
+
+        _uiThread = Thread.CurrentThread;
+        StopSession();
+
+        if (_control is null || _control.IsDisposed)
+        {
+            _control = new RuffleControl { Name = "ruffle", Dock = WinForms.DockStyle.Fill, TabIndex = 0 };
+            _control.ShownAgain += () =>
+            {
+                if (_session is { } current && current.Connected.IsSet)
+                    Send(current, new JObject { ["t"] = "refresh" });
+            };
+            // MainWindow puts the control into its game panel.
+            _messenger.Send<FlashChangedMessage<WinForms.Control>>(new(_control));
+        }
+
+        IntPtr parent = _control.Handle;
+        string pipeName = $"skua-ruffle-{Environment.ProcessId}-{Interlocked.Increment(ref _sessionCounter)}";
+
+        var session = new Session(pipeName);
+        _session = session;
+
+        var startInfo = new ProcessStartInfo(exe)
+        {
+            UseShellExecute = false,
+            WorkingDirectory = Path.GetDirectoryName(exe)!,
+        };
+        startInfo.ArgumentList.Add("--skua-pipe");
+        startInfo.ArgumentList.Add(pipeName);
+        startInfo.ArgumentList.Add("--skua-movie");
+        startInfo.ArgumentList.Add(swfPath);
+        startInfo.ArgumentList.Add("--skua-parent");
+        startInfo.ArgumentList.Add(parent.ToInt64().ToString(CultureInfo.InvariantCulture));
+        ApplyRuffleOptions(startInfo);
+        // Read again at every start, so editing ruffle-options.txt takes effect with the next restart.
+        _memoryLimitMb = startInfo.Environment.TryGetValue("SKUA_MEMORY_LIMIT_MB", out string? limit)
+            && long.TryParse(limit, out long limitMb) && limitMb > 0 ? limitMb : 6000;
+        StartHealthTimer();
+
+        try
+        {
+            session.Process = Process.Start(startInfo) ?? throw new InvalidOperationException("Process.Start returned null");
+        }
+        catch (Exception ex)
+        {
+            Trace.WriteLine($"Ruffle start error: {ex}");
+            WinForms.MessageBox.Show($"Couldn't start the Ruffle player:\r\n{ex.Message}", "Ruffle",
+                WinForms.MessageBoxButtons.OK, WinForms.MessageBoxIcon.Error);
+            session.Dispose();
+            _session = null;
+            return;
+        }
+
+        session.Process.EnableRaisingEvents = true;
+        session.Process.Exited += (_, _) => OnRuffleExited(session);
+
+        var thread = new Thread(() => RunSession(session)) { IsBackground = true, Name = "Ruffle pipe reader" };
+        thread.Start();
+    }
+
+    private static int _sessionCounter;
+
+    private void RunSession(Session session)
+    {
+        try
+        {
+            Task.WaitAll(new[]
+            {
+                session.ToRuffle.WaitForConnectionAsync(session.Cancel.Token),
+                session.FromRuffle.WaitForConnectionAsync(session.Cancel.Token),
+            });
+            session.Connected.Set();
+            Trace.WriteLine($"Ruffle connected (pipe {session.Name}).");
+
+            byte[] header = new byte[4];
+            while (!session.Cancel.IsCancellationRequested)
+            {
+                if (!ReadExactly(session.FromRuffle, header))
+                    break;
+                int length = BitConverter.ToInt32(header, 0);
+                byte[] body = new byte[length];
+                if (!ReadExactly(session.FromRuffle, body))
+                    break;
+                HandleMessage(session, JObject.Parse(Encoding.UTF8.GetString(body)));
+            }
+        }
+        catch (Exception ex) when (ex is OperationCanceledException || ex is ObjectDisposedException
+                                   || ex is IOException || (ex is AggregateException ae && ae.InnerExceptions.All(e => e is OperationCanceledException or IOException)))
+        {
+        }
+        catch (Exception ex)
+        {
+            Trace.WriteLine($"Ruffle pipe error: {ex}");
+        }
+        finally
+        {
+            FailPending(session);
+        }
+    }
+
+    private static bool ReadExactly(Stream stream, byte[] buffer)
+    {
+        int read = 0;
+        while (read < buffer.Length)
+        {
+            int n = stream.Read(buffer, read, buffer.Length - read);
+            if (n <= 0)
+                return false;
+            read += n;
+        }
+        return true;
+    }
+
+    private void HandleMessage(Session session, JObject message)
+    {
+        switch ((string?)message["t"])
+        {
+            case "ret":
+                long id = (long)message["id"]!;
+                if (_pending.TryRemove(id, out PendingCall? call))
+                {
+                    call.Result = message["v"];
+                    call.Done.Set();
+                }
+                break;
+
+            case "ev":
+                string name = (string?)message["n"] ?? string.Empty;
+                // Same shape FlashUtil produced: its CallHandler turned the whole <arguments> element
+                // into one string (all the text inside it, run together), and Skua's handlers rely on
+                // that, e.g. "pext" reads args[0] as the packet's JSON.
+                var text = new StringBuilder();
+                if (message["a"] is JArray rawArgs)
+                    foreach (JToken arg in rawArgs)
+                        AppendFlashText(arg, text);
+                RaiseFlashCall(name, new object[] { text.ToString() });
+                break;
+
+            case "hello":
+                long hwnd = message["hwnd"]?.Type == JTokenType.Integer ? (long)message["hwnd"]! : 0;
+                if (hwnd != 0)
+                    _control?.SetGameWindow(new IntPtr(hwnd));
+                if (_headless)
+                    SendHeadless(session, true);
+                break;
+
+            case "cb":
+                break;
+        }
+    }
+
+    private void RaiseFlashCall(string name, object[] args)
+    {
+        // Flash raised these on the UI thread, and the handlers expect that.
+        Dispatcher.UIThread.Post(() =>
+        {
+            try
+            {
+                FlashCall?.Invoke(name, args);
+            }
+            catch (Exception ex)
+            {
+                Trace.WriteLine($"Flash CallHandler exception: {ex.Message}");
+            }
+        });
+    }
+
+    private void OnRuffleExited(Session session)
+    {
+        if (!ReferenceEquals(_session, session) || _disposed)
+            return;
+
+        int code = -1;
+        try { code = session.Process!.ExitCode; } catch { /* ignored */ }
+        Trace.WriteLine($"Ruffle exited unexpectedly (code {code}).");
+        session.Cancel.Cancel();
+        FailPending(session);
+
+        // Always start a new player (the login watchdog then logs back in), but wait a little when
+        // it keeps crashing, so a crash loop doesn't hammer the PC or AQW.
+        TimeSpan delay = DateTime.UtcNow - _lastRestart < TimeSpan.FromMinutes(2) ? TimeSpan.FromSeconds(30) : TimeSpan.Zero;
+        _lastRestart = DateTime.UtcNow + delay;
+        _ = Task.Delay(delay).ContinueWith(_ => Dispatcher.UIThread.Post(() =>
+        {
+            if (!_disposed && ReferenceEquals(_session, session))
+                InitializeFlash();
+        }));
+    }
+
+    // ---- Health check (week-long runs) ----------------------------------------------------------------
+    // Every 30 s: a quick call to the game. Three unanswered in a row (about a minute and a half
+    // frozen) and the game window is restarted; the login watchdog then logs back in and restarts the
+    // script. Also a memory safety net: past SKUA_MEMORY_LIMIT_MB (ruffle-options.txt, default 6000)
+    // the window is restarted once the account is out of combat (or after 10 minutes regardless).
+
+    private System.Threading.Timer? _healthTimer;
+    private int _healthBusy;
+    private int _missedBeats;
+    private DateTime _overLimitSince = DateTime.MinValue;
+    private DateTime _lastMemoryRestart = DateTime.MinValue;
+    private bool _loggedTooSoon;
+    private static long _memoryLimitMb = 6000;
+
+    private void StartHealthTimer()
+    {
+        _healthTimer ??= new System.Threading.Timer(_ => HealthTick(), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(30));
+    }
+
+    private void HealthTick()
+    {
+        if (_disposed || Interlocked.Exchange(ref _healthBusy, 1) == 1)
+            return;
+        try
+        {
+            Session? session = _session;
+            if (session is null || !session.Connected.IsSet || session.Process is not { } process || process.HasExited)
+                return;
+
+            if (Ping(session, TimeSpan.FromSeconds(15)))
+            {
+                _missedBeats = 0;
+            }
+            else if (++_missedBeats >= 3)
+            {
+                _missedBeats = 0;
+                HealthLog(" the game window stopped answering (frozen for over a minute); restarting it.");
+                KillPlayer(session);
+                return;
+            }
+
+            process.Refresh();
+            long committedMb = process.PrivateMemorySize64 >> 20;
+            // Also when the whole PC is running out of memory: the biggest game window goes first.
+            long freeMb = FreeRamMb(out long totalMb);
+            bool pcLow = totalMb > 0 && (freeMb < totalMb / 10 || freeMb < 1500)
+                && committedMb >= 2500 && IsBiggestGameWindow(process, committedMb);
+            if (committedMb <= _memoryLimitMb && !pcLow)
+            {
+                _overLimitSince = DateTime.MinValue;
+                return;
+            }
+            if (_overLimitSince == DateTime.MinValue)
+                _overLimitSince = DateTime.UtcNow;
+            bool inCombat = false;
+            try { inCombat = CommunityToolkit.Mvvm.DependencyInjection.Ioc.Default.GetService<IScriptPlayer>()?.InCombat ?? false; } catch { }
+            // A limit set lower than the game needs would restart it over and over: at most once per 30 minutes.
+            if (DateTime.UtcNow - _lastMemoryRestart < TimeSpan.FromMinutes(30))
+            {
+                if (!_loggedTooSoon)
+                    HealthLog($" the game window uses {committedMb} MB (limit {_memoryLimitMb} MB), but it was restarted for memory less than 30 minutes ago; waiting. If this keeps happening, raise SKUA_MEMORY_LIMIT_MB.");
+                _loggedTooSoon = true;
+                return;
+            }
+            if (!inCombat || DateTime.UtcNow - _overLimitSince > TimeSpan.FromMinutes(10))
+            {
+                _overLimitSince = DateTime.MinValue;
+                _lastMemoryRestart = DateTime.UtcNow;
+                _loggedTooSoon = false;
+                HealthLog(committedMb > _memoryLimitMb
+                    ? $" the game window uses {committedMb} MB (limit {_memoryLimitMb} MB); restarting it."
+                    : $" the PC is low on memory ({freeMb} MB of {totalMb} MB free) and this is the biggest game window ({committedMb} MB); restarting it.");
+                KillPlayer(session);
+            }
+        }
+        catch (Exception ex)
+        {
+            Trace.WriteLine($"Ruffle health check: {ex.Message}");
+        }
