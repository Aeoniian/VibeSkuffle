+
+    public string Call(string function, params object[] args)
+    {
+        return Call<string>(function, args);
+    }
+
+    public T Call<T>(string function, params object[] args)
+    {
+        try
+        {
+            object? o = Call(function, typeof(T), args);
+            return o is T value ? value : GetDefaultValue<T>();
+        }
+        catch
+        {
+            return GetDefaultValue<T>();
+        }
+    }
+
+    private static T GetDefaultValue<T>()
+    {
+        object? defaultValue = DefaultProvider.GetDefault<T>(typeof(T));
+        return defaultValue is T typed ? typed : default!;
+    }
+
+    public object Call(string function, Type type, params object[] args)
+    {
+        if (_lazyManager.Value.ShouldExit && Thread.CurrentThread.Name == "Script Thread")
+            _lazyManager.Value.ScriptCts?.Token.ThrowIfCancellationRequested();
+
+        try
+        {
+            Session? session = _session;
+            if (session is null)
+                return default!;
+
+            if (!session.Connected.IsSet && !Wait(session.Connected.WaitHandle, ConnectTimeout))
+                return default!;
+
+            long id = Interlocked.Increment(ref _nextId);
+            var call = new PendingCall(session);
+            _pending[id] = call;
+
+            var request = new JObject
+            {
+                ["t"] = "call",
+                ["id"] = id,
+                ["n"] = function,
+                ["a"] = new JArray(args.Select(ToJson)),
+            };
+            if (!Send(session, request))
+            {
+                _pending.TryRemove(id, out _);
+                return default!;
+            }
+
+            if (!Wait(call.Done.WaitHandle, CallTimeout))
+            {
+                _pending.TryRemove(id, out _);
+                Trace.WriteLine($"Ruffle call '{function}' timed out.");
+                return default!;
+            }
+
+            string? text = ReturnText(call.Result);
+            if (text is null)
+                return default!;
+
+            object? value = Convert.ChangeType(text, type);
+            return value ?? default!;
+        }
+        catch (Exception e)
+        {
+            if (function != "isKicked")
+                _messenger.Send<FlashErrorMessage>(new(e, function, args));
+            return default!;
+        }
+    }
+
+    /// <summary>Turns drawing off (the game keeps running) or back on.</summary>
+    public void SetHeadless(bool on)
+    {
+        _headless = on;
+        if (_session is { } session && session.Connected.IsSet)
+            SendHeadless(session, on);
+    }
+
+    private void SendHeadless(Session session, bool on)
+    {
+        Send(session, new JObject { ["t"] = "headless", ["on"] = on });
+    }
+
+    /// <summary>
+    /// Asks the game player to free memory it isn't using right now (shapes not drawn for a while,
+    /// spare textures, memory its allocator keeps for reuse). For accounts in background tabs.
+    /// </summary>
+    public void TrimGameMemory()
+    {
+        if (_session is not { } session || !session.Connected.IsSet)
+            return;
+        Send(session, new JObject { ["t"] = "trim" });
+        // Then hand the memory the game isn't touching back to Windows (it comes back on its own
+        // when needed). Measured with 6 idle accounts: ~5.4 GB -> ~1.8 GB, no stutter.
+        _ = Task.Delay(3000).ContinueWith(_ =>
+        {
+            try
+            {
+                if (ReferenceEquals(_session, session) && session.Process is { HasExited: false } p)
+                    EmptyWorkingSet(p.Handle);
+            }
+            catch { /* the player went away meanwhile */ }
+        });
+    }
+
+    [DllImport("psapi.dll")]
+    private static extern bool EmptyWorkingSet(IntPtr hProcess);
+
+    /// <summary>
+    /// Extra options for the game player from <c>ruffle-options.txt</c> next to VibeSkuffle.exe:
+    /// lines starting with "-" are command-line options (e.g. <c>--graphics dx12</c>), lines with
+    /// "=" are environment variables (e.g. <c>RUFFLE_GPU_BLOCK_MB=4-16</c>); "#" starts a comment.
+    /// </summary>
+    /// <summary>The account this client logs in with (-u / --user), lower case, or "".</summary>
+    private static string ThisAccount()
+    {
+        string[] args = Environment.GetCommandLineArgs();
+        for (int i = 0; i + 1 < args.Length; i++)
+            if (args[i] is "-u" or "--user")
+                return args[i + 1].Trim().ToLowerInvariant();
+        return "";
+    }
+
+    private static void ApplyRuffleOptions(ProcessStartInfo startInfo)
+    {
+        string path = Path.Combine(AppContext.BaseDirectory, "ruffle-options.txt");
+        if (!File.Exists(path))
+            return;
+        // Command-line options by their flag (e.g. "--graphics"): an account's own line wins over a
+        // line for everyone, wherever it is in the file, and a later line wins over an earlier one of
+        // the same kind, so the player never gets the same option twice.
+        var options = new List<(string Flag, string[] Parts, bool Account)>();
+        try
+        {
+            foreach (string raw in File.ReadAllLines(path))
+            {
+                string line = raw.Trim();
+                if (line.Length == 0 || line.StartsWith('#'))
+                    continue;
+                // "name: ..." applies to that account only, e.g. "myalt: SKUA_MEMORY_LIMIT_MB=8000".
+                bool account = false;
+                int colon = line.IndexOf(':');
+                int equals = line.IndexOf('=');
+                if (!line.StartsWith('-') && colon > 0 && (equals < 0 || colon < equals))
+                {
+                    if (!line[..colon].Trim().Equals(ThisAccount(), StringComparison.OrdinalIgnoreCase))
+                        continue;
+                    line = line[(colon + 1)..].Trim();
+                    if (line.Length == 0)
+                        continue;
+                    account = true;
+                }
+                if (line.StartsWith('-'))
+                {
+                    string[] parts = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+                    string flag = parts[0].Split('=')[0];
+                    int existing = options.FindIndex(o => o.Flag == flag);
+                    if (existing < 0)
+                        options.Add((flag, parts, account));
+                    else if (account || !options[existing].Account)
+                        options[existing] = (flag, parts, account);
+                }
+                else if (line.IndexOf('=') is > 0 and int eq)
+                {
+                    string name = line[..eq].Trim(), value = line[(eq + 1)..].Trim();
+                    startInfo.Environment[name] = value;
+                    // SKUA_* settings are for VibeSkuffle itself too (e.g. SKUA_STUCK_SCRIPT_MINUTES).
+                    if (name.StartsWith("SKUA_", StringComparison.OrdinalIgnoreCase))
+                        Environment.SetEnvironmentVariable(name, value);
+                }
+            }
+        }
+        catch (Exception ex)
+        {
+            Trace.WriteLine($"ruffle-options.txt: {ex.Message}");
+        }
+        foreach ((_, string[] parts, _) in options)
+            foreach (string part in parts)
+                startInfo.ArgumentList.Add(part);
+    }
+
+    private bool Send(Session session, JObject message)
+    {
+        byte[] body = Encoding.UTF8.GetBytes(message.ToString(Formatting.None));
+        try
+        {
+            lock (_writeLock)
+            {
+                session.ToRuffle.Write(BitConverter.GetBytes(body.Length), 0, 4);
+                session.ToRuffle.Write(body, 0, body.Length);
+                session.ToRuffle.Flush();
+            }
+            return true;
+        }
+        catch (Exception ex) when (ex is IOException or ObjectDisposedException or InvalidOperationException)
+        {
+            return false;
+        }
+    }
+
+    /// <summary>
+    /// Waits for <paramref name="handle"/>. On the UI thread it keeps handling messages Windows sends
+    /// synchronously (the game window is a child of Skua's window and lives in another process, so
+    /// both sides send each other messages); posted messages stay queued, so no UI code re-enters.
+    /// </summary>
+    private bool Wait(WaitHandle handle, TimeSpan timeout)
+    {
+        if (Thread.CurrentThread != _uiThread)
+            return handle.WaitOne(timeout);
+
+        long deadline = Environment.TickCount64 + (long)timeout.TotalMilliseconds;
+        IntPtr[] handles = { handle.SafeWaitHandle.DangerousGetHandle() };
+        while (true)
+        {
+            long left = deadline - Environment.TickCount64;
+            if (left <= 0)
+                return handle.WaitOne(0);
+            uint result = MsgWaitForMultipleObjectsEx(1, handles, (uint)left, QS_SENDMESSAGE, MWMO_INPUTAVAILABLE);
+            if (result == WAIT_OBJECT_0)
+                return true;
+            if (result == WAIT_OBJECT_0 + 1)
+                PeekMessage(out _, IntPtr.Zero, 0, 0, PM_NOREMOVE | PM_QS_SENDMESSAGE);
+            else if (result == WAIT_TIMEOUT)
+                return handle.WaitOne(0);
+            else
+                return handle.WaitOne(timeout); // WAIT_FAILED: plain wait
+        }
+    }
+
+    private void FailPending(Session session)
+    {
+        foreach (var (id, call) in _pending)
+        {
+            if (ReferenceEquals(call.Session, session) && _pending.TryRemove(id, out _))
+                call.Done.Set();
+        }
+    }
+
+    private void StopSession()
+    {
+        Session? old = _session;
+        _session = null;
+        if (old is null)
+            return;
+        try
+        {
+            if (old.Connected.IsSet)
+                Send(old, new JObject { ["t"] = "quit" });
+        }
+        catch { /* ignored */ }
+        old.Cancel.Cancel();
+        FailPending(old);
+        try
+        {
+            if (old.Process is { HasExited: false } p && !p.WaitForExit(1500))
+                p.Kill(true);
+        }
+        catch { /* ignored */ }
+        old.Dispose();
+        _control?.SetGameWindow(IntPtr.Zero);
+    }
+
+    // ---- Value conversion (mirrors FlashUtil's XML conversion) ------------------------------------
+
+    /// <summary>Same mapping as <see cref="FlashUtil.ToFlashXml(object)"/>.</summary>
+    private static JToken ToJson(object? o)
+    {
+        switch (o)
+        {
+            case null:
+                return JValue.CreateNull();
+            case bool b:
+                return new JValue(b);
+            case double d:
+                return Number(d);
+            case float f:
+                return Number(f);
+            case long l:
+                return new JValue(l);
+            case int i:
+                return new JValue(i);
+            case ExpandoObject expando:
+                var fields = new JObject();
+                foreach (KeyValuePair<string, object?> kvp in (IDictionary<string, object?>)expando)
+                    fields[kvp.Key] = ToJson(kvp.Value);
+                return new JObject { ["$o"] = fields };
+            case Array array:
+                var list = new JArray();
+                foreach (object? el in array)
+                    list.Add(ToJson(el));
+                return list;
+            default:
+                return new JValue(o.ToString());
+        }
+    }
+
+    private static JToken Number(double d)
+    {
+        if (double.IsNaN(d))
+            return new JObject { ["$n"] = "NaN" };
+        if (double.IsInfinity(d))
+            return new JObject { ["$n"] = d > 0 ? "Infinity" : "-Infinity" };
+        return new JValue(d);
+    }
+
+    /// <summary>
+    /// Appends what <c>XElement.Value</c> gives for Flash's XML form of <paramref name="token"/>: the text of
+    /// strings and numbers, nothing for booleans, null and undefined, and the values of arrays and objects.
+    /// </summary>
+    private static void AppendFlashText(JToken token, StringBuilder text)
+    {
+        switch (token.Type)
+        {
+            case JTokenType.String:
+                text.Append(token.Value<string>());
+                break;
+            case JTokenType.Integer:
+                text.Append(token.Value<long>().ToString(CultureInfo.InvariantCulture));
+                break;
+            case JTokenType.Float:
+                double d = token.Value<double>();
+                text.Append(d == Math.Floor(d) && Math.Abs(d) < 1e15
+                    ? ((long)d).ToString(CultureInfo.InvariantCulture)
+                    : d.ToString("R", CultureInfo.InvariantCulture));
+                break;
+            case JTokenType.Array:
+                foreach (JToken item in token)
+                    AppendFlashText(item, text);
+                break;
+            case JTokenType.Object:
+                var obj = (JObject)token;
+                if (obj["$n"] is JValue special)
+                    text.Append((string?)special);
+                else if (!obj.ContainsKey("$u"))
+                    foreach (var (_, value) in (obj["$o"] as JObject) ?? obj)
+                        if (value is not null)
+                            AppendFlashText(value, text);
+                break;
+        }
+    }
+
+    /// <summary>Same mapping as <see cref="FlashUtil.FromFlashXml(XElement)"/>.</summary>
+    private static object FromJson(JToken token)
+    {
+        switch (token.Type)
+        {
+            case JTokenType.Integer:
+            case JTokenType.Float:
+                double d = token.Value<double>();
+                if (d == Math.Floor(d) && d >= int.MinValue && d <= int.MaxValue)
+                    return (int)d;
+                return (float)d;
+            case JTokenType.Boolean:
+                return token.Value<bool>();
+            case JTokenType.Null:
+                return null!;
+            case JTokenType.String:
+                return token.Value<string>()!;
+            case JTokenType.Array:
+                return token.Select(FromJson).ToArray();
+            case JTokenType.Object:
+                var obj = (JObject)token;
+                if (obj.ContainsKey("$u"))
+                    return string.Empty; // Flash's <undefined/> became "" as well.
+                if (obj["$n"] is JValue special)
+                    return (string?)special switch { "Infinity" => float.PositiveInfinity, "-Infinity" => float.NegativeInfinity, _ => float.NaN };
+                var expando = new ExpandoObject();
+                var dict = (IDictionary<string, object?>)expando;
+                foreach (var (key, value) in (obj["$o"] as JObject) ?? obj)
+                    dict[key] = value is null ? null : FromJson(value);
+                return expando;
+            default:
+                return token.ToString();
+        }
+    }
+
+    /// <summary>
+    /// The text <see cref="FlashUtil"/> would have read from Flash's XML answer (the first node of the
+    /// value element), or <see langword="null"/> where it got none (booleans, null, undefined).
+    /// One difference: strings come back exactly as the game has them, where the XML path returned
+    /// them XML-escaped (an item named "A &amp; B" came back as "A &amp;amp; B").
+    /// </summary>
+    private static string? ReturnText(JToken? token)
+    {
+        if (token is null)
+            return null;
+        switch (token.Type)
+        {
+            case JTokenType.String:
+                string s = token.Value<string>()!;
+                return s.Length == 0 ? null : s;
+            case JTokenType.Integer:
+                return token.Value<long>().ToString(CultureInfo.CurrentCulture);
+            case JTokenType.Float:
+                double d = token.Value<double>();
+                return d == Math.Floor(d) && Math.Abs(d) < 1e15
+                    ? ((long)d).ToString(CultureInfo.CurrentCulture)
+                    : d.ToString("R", CultureInfo.CurrentCulture);
+            case JTokenType.Object when token["$n"] is JValue special:
+                return (string?)special;
+            case JTokenType.Object when token["$u"] is not null:
+                return null;
+            case JTokenType.Array:
+            case JTokenType.Object:
+                return token.ToString(Formatting.None);
+            default:
+                return null;
+        }
+    }
+
+    public object FromFlashXml(XElement el)
+    {
+        switch (el.Name.ToString())
+        {
+            case "number":
+                return int.TryParse(el.Value, out int i) ? i : float.TryParse(el.Value, out float f) ? f : 0;
+            case "true":
+                return true;
+            case "false":
+                return false;
+            case "null":
+                return null!;
+            case "array":
+                return el.Elements().Select(e => FromFlashXml(e)).ToArray();
+            case "object":
+                var d = new ExpandoObject();
+                var dict = (IDictionary<string, object?>)d;
+                foreach (XElement e in el.Elements())
+                    dict[e.Attribute("id")!.Value] = FromFlashXml(e.Elements().First());
+                return d;
+            default:
+                return el.Value;
+        }
+    }
+
+    public IFlashObject<T> CreateFlashObject<T>(string path)
+    {
+        return new FlashObject<T>(Call<int>("lnkCreate", path), this);
+    }
+
+    public void Dispose()
+    {
+        _disposed = true;
+        try { StopSession(); } catch { /* ignored */ }
+    }
+
+    // ---- Plumbing ---------------------------------------------------------------------------
+
+    private sealed class PendingCall
+    {
+        public PendingCall(Session session) => Session = session;
+        public Session Session { get; }
+        public ManualResetEventSlim Done { get; } = new(false);
+        public JToken? Result { get; set; }
+    }
+
+    private sealed class Session : IDisposable
+    {
+        public Session(string name)
+        {
+            Name = name;
+            ToRuffle = new NamedPipeServerStream(name + "-c2r", PipeDirection.Out, 1, PipeTransmissionMode.Byte, PipeOptions.Asynchronous, 0, 64 * 1024);
+            FromRuffle = new NamedPipeServerStream(name + "-r2c", PipeDirection.In, 1, PipeTransmissionMode.Byte, PipeOptions.Asynchronous, 64 * 1024, 0);
+        }
+
+        public string Name { get; }
+        public NamedPipeServerStream ToRuffle { get; }
+        public NamedPipeServerStream FromRuffle { get; }
+        public Process? Process { get; set; }
+        public ManualResetEventSlim Connected { get; } = new(false);
+        public CancellationTokenSource Cancel { get; } = new();
+
+        public void Dispose()
+        {
+            try { Cancel.Cancel(); } catch { /* ignored */ }
+            try { ToRuffle.Dispose(); } catch { /* ignored */ }
+            try { FromRuffle.Dispose(); } catch { /* ignored */ }
+            try { Process?.Dispose(); } catch { /* ignored */ }
+        }
+    }
+
+    private const uint QS_SENDMESSAGE = 0x0040;
+    private const uint MWMO_INPUTAVAILABLE = 0x0004;
+    private const uint WAIT_OBJECT_0 = 0;
+    private const uint WAIT_TIMEOUT = 0x102;
+    private const uint PM_NOREMOVE = 0x0000;
+    private const uint PM_QS_SENDMESSAGE = QS_SENDMESSAGE << 16;
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct MSG
+    {
+        public IntPtr hwnd;
+        public uint message;
+        public IntPtr wParam;
+        public IntPtr lParam;
+        public uint time;
+        public int ptX;
+        public int ptY;
+    }
+
+    [DllImport("user32.dll")]
+    private static extern uint MsgWaitForMultipleObjectsEx(uint nCount, IntPtr[] pHandles, uint dwMilliseconds, uint dwWakeMask, uint dwFlags);
+
+    [DllImport("user32.dll")]
+    private static extern bool PeekMessage(out MSG lpMsg, IntPtr hWnd, uint wMsgFilterMin, uint wMsgFilterMax, uint wRemoveMsg);
+}
+#else
+public sealed class RuffleFlashUtil : IFlashUtil
+{
+    public event FlashCallHandler? FlashCall;
+    public void Dispose() { }
+    public void InitializeFlash() => throw new PlatformNotSupportedException();
+    public string? Call(string function, params object[] args) => throw new PlatformNotSupportedException();
+    public T? Call<T>(string function, params object[] args) => throw new PlatformNotSupportedException();
+    public object? Call(string function, Type type, params object[] args) => throw new PlatformNotSupportedException();
+    public object FromFlashXml(XElement el) => throw new PlatformNotSupportedException();
+    public IFlashObject<T> CreateFlashObject<T>(string path) => throw new PlatformNotSupportedException();
+    public void SetHeadless(bool on) { }
+
+    public void TrimGameMemory() { }
+}
+#endif
