+using System.Linq;
+using System.Threading.Tasks;
+
+namespace Skua.Shared.Avalonia.ViewModels.ScriptRepo;
+
+public partial class ScriptRepoViewModel
+{
+    private int _outdatedQuantity;
+    private int _outdatedCountRevision;
+
+    private void ApplyOutdatedQuantity(int count)
+    {
+        _outdatedCountRevision++;
+        _outdatedQuantity = count;
+    }
+
+    // Outdated checks may hash every local script. Bindings must read a completed
+    // count, rather than repeat those file operations on the UI thread.
+    private async Task RefreshOutdatedQuantityAsync()
+    {
+        int revision = ++_outdatedCountRevision;
+        var scripts = _scripts.ToArray();
+        int count = await Task.Run(() => scripts.Count(s => s.Outdated));
+        if (revision == _outdatedCountRevision)
+            _outdatedQuantity = count;
+    }
+}
