diff --git a/Skua.Core/Services/PortableUpdatePackage.cs b/Skua.Core/Services/PortableUpdatePackage.cs
new file mode 100644
index 0000000..56a8b56
--- /dev/null
+++ b/Skua.Core/Services/PortableUpdatePackage.cs
@@ -0,0 +1,65 @@
+using System.IO.Compression;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Skua.Core.Services;
+
+/// <summary>Only application-owned, hash-verified files may enter an update transaction.</summary>
+public static class PortableUpdatePackage
+{
+    public sealed record Manifest(string Version, Dictionary<string, string> Files);
+    public const string ManifestName = "vibeskuffle-update.json";
+    public static bool IsApplicationFile(string relative)
+    {
+        string path = relative.Replace('\\', '/');
+        if (Path.IsPathRooted(path) || path.Split('/').Any(p => p is "" or "." or ".." || p.Contains(':'))) return false;
+        string lower = path.ToLowerInvariant();
+        if (lower.StartsWith("assemblies/")) return lower.EndsWith(".dll") || lower.EndsWith(".so") || lower.EndsWith(".dylib");
+        if (lower.StartsWith("ruffle/")) return lower is "ruffle/mugetsu.exe" || lower.EndsWith(".dll");
+        if (lower.StartsWith("plugins/")) return lower is "plugins/butlerv5.dll" or "plugins/dailytracker.dll" or "plugins/skua.plugin.dailytracker.dll" or "plugins/skua.plugin.cosmetics.dll";
+        return lower is "vibeskuffle.exe" or "vibeskuffle.dll" or "vibeskuffle.deps.json" or "vibeskuffle.runtimeconfig.json"
+            or "vibeskuffle.manager.exe" or "vibeskuffle.manager.dll" or "vibeskuffle.manager.deps.json" or "vibeskuffle.manager.runtimeconfig.json"
+            or "skua.swf" or "use-ruffle.txt" or "velopack.dll" or "build-info.txt" or "release-version.txt" or "client-update.ps1";
+    }
+
+    public static Manifest Stage(string archive, string destination)
+    {
+        using ZipArchive zip = ZipFile.OpenRead(archive);
+        ZipArchiveEntry[] manifests = zip.Entries.Where(e => e.Name.Equals(ManifestName, StringComparison.OrdinalIgnoreCase)).ToArray();
+        if (manifests.Length != 1) throw new InvalidDataException("This release has no unique safe-update manifest. Install it manually.");
+        ZipArchiveEntry manifestEntry = manifests[0];
+        if (manifestEntry.Length > 2_000_000) throw new InvalidDataException("Invalid update manifest size.");
+        using Stream manifestStream = manifestEntry.Open();
+        Manifest manifest = JsonSerializer.Deserialize<Manifest>(manifestStream, new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
+            ?? throw new InvalidDataException("Invalid update manifest.");
+        if (manifest.Files == null || manifest.Files.Count == 0 || manifest.Files.Count > 5000) throw new InvalidDataException("Invalid update file list.");
+        string prefix = manifestEntry.FullName[..^ManifestName.Length];
+        var entries = new Dictionary<string, ZipArchiveEntry>(StringComparer.OrdinalIgnoreCase);
+        foreach (ZipArchiveEntry entry in zip.Entries)
+            if (!entries.TryAdd(entry.FullName.Replace('\\', '/'), entry)) throw new InvalidDataException("Duplicate archive path.");
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        long size = 0;
+        Directory.CreateDirectory(destination);
+        foreach ((string relative, string expected) in manifest.Files)
+        {
+            if (!IsApplicationFile(relative) || !seen.Add(relative.Replace('\\', '/')))
+                throw new InvalidDataException($"Protected or duplicate update path: {relative}");
+            if (expected == null || expected.Length != 64 || !expected.All(Uri.IsHexDigit)) throw new InvalidDataException("Invalid SHA-256.");
+            string archivePath = prefix + relative.Replace('\\', '/');
+            if (!entries.TryGetValue(archivePath, out ZipArchiveEntry? entry)) throw new InvalidDataException($"Missing application file: {relative}");
+            size += entry.Length;
+            if (size > 1_000_000_000) throw new InvalidDataException("Update exceeds maximum unpacked size.");
+            string output = Path.GetFullPath(Path.Combine(destination, relative));
+            if (!output.StartsWith(Path.GetFullPath(destination) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException("Unsafe update path.");
+            Directory.CreateDirectory(Path.GetDirectoryName(output)!);
+            using (Stream input = entry.Open())
+            using (FileStream target = File.Create(output)) input.CopyTo(target);
+            using FileStream verify = File.OpenRead(output);
+            if (!Convert.ToHexString(SHA256.HashData(verify)).Equals(expected, StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException($"Hash mismatch: {relative}");
+        }
+        foreach (string required in new[] { "VibeSkuffle.exe", "VibeSkuffle.dll", "VibeSkuffle.Manager.exe", "VibeSkuffle.Manager.dll", "ruffle/Mugetsu.exe", "plugins/ButlerV5.dll" })
+            if (!seen.Contains(required)) throw new InvalidDataException($"Incomplete client package: {required}");
+        File.WriteAllText(Path.Combine(destination, ManifestName), JsonSerializer.Serialize(manifest));
+        return manifest;
+    }
+}
