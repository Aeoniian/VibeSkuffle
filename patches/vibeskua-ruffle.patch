diff --git a/Skua.App.Avalonia/Views/TabbedHostWindow.ArmyOptions.cs b/Skua.App.Avalonia/Views/TabbedHostWindow.ArmyOptions.cs
new file mode 100644
index 0000000..23a4d7b
--- /dev/null
+++ b/Skua.App.Avalonia/Views/TabbedHostWindow.ArmyOptions.cs
@@ -0,0 +1,96 @@
+using Avalonia.Controls;
+using Avalonia.Interactivity;
+using Avalonia.Media;
+using Avalonia.Threading;
+using Material.Icons.Avalonia;
+using Skua.Core.Services;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace Skua.App.Avalonia.Views;
+
+public partial class TabbedHostWindow
+{
+    private readonly Dictionary<string, (bool Target, DateTime Sent)> _pendingArmyOptions = new();
+    private readonly Dictionary<string, DateTime> _failedArmyOptions = new();
+    private DispatcherTimer? _armyOptionsTimer;
+    private bool _armyOptionRefreshQueued;
+
+    private void ArmyOptionStateReported(int processId, IntPtr childHwnd)
+    {
+        if (_isClosing || _armyOptionRefreshQueued || childHwnd == IntPtr.Zero ||
+            !_tabs.Values.Any(t => t.Process is not null && !t.Process.HasExited &&
+                t.Process.Id == processId && t.ChildHwnd == childHwnd)) return;
+        _armyOptionRefreshQueued = true;
+        Dispatcher.UIThread.Post(() =>
+        {
+            _armyOptionRefreshQueued = false;
+            if (!_isClosing) RefreshArmyOptions();
+        }, DispatcherPriority.Background);
+    }
+
+    private void InitializeArmyOptions()
+    {
+        RefreshArmyOptions();
+        _armyOptionsTimer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(1) };
+        _armyOptionsTimer.Tick += (_, _) => RefreshArmyOptions();
+        _armyOptionsTimer.Start();
+        Closed += (_, _) => _armyOptionsTimer.Stop();
+    }
+    private List<(TabInfo Tab, ArmyOptionSnapshot? State)> ArmyStates() => InstancesTabControl.Items.OfType<TabItem>().Where(_tabs.ContainsKey).Select(t => _tabs[t])
+        .Where(t => t.Process is not null && !t.Process.HasExited)
+        .Select(t => (t, ArmyOptionFeedback.Read(t.Process.Id))).ToList();
+
+    private void RefreshArmyOptions()
+    {
+        var states = ArmyStates();
+        foreach (var item in MiscOptionsMenu.Items.OfType<MenuItem>())
+        {
+            string name = item.Tag?.ToString() ?? "";
+            if (name.Length == 0) continue;
+            string label = name switch { "LagKiller" => "Lag Killer", "HeadlessMode" => "Headless Mode", "HidePlayers" => "Hide Players",
+                "DisableFX" => "Disable FX", "InfiniteRange" => "Infinite Range", "StreamerMode" => "Streamer Mode", _ => "Aggro Monsters" };
+            var values = states.Select(s => s.State?.Options.TryGetValue(name, out bool value) == true ? (bool?)value : null).ToArray();
+            string status = ArmyOptionFeedback.Summarize(values);
+            if (_pendingArmyOptions.TryGetValue(name, out var pending))
+            {
+                if (states.Count > 0 && states.All(s => s.State is not null && s.State.UpdatedUtc >= pending.Sent &&
+                    s.State.Options.TryGetValue(name, out bool value) && value == pending.Target))
+                { _pendingArmyOptions.Remove(name); _failedArmyOptions.Remove(name); }
+                else if (DateTime.UtcNow - pending.Sent < TimeSpan.FromSeconds(8)) status = "Pending";
+                else { _pendingArmyOptions.Remove(name); _failedArmyOptions[name] = pending.Sent; }
+            }
+            if (_failedArmyOptions.TryGetValue(name, out var failed))
+            {
+                if (states.All(s => s.State is not null && s.State.UpdatedUtc >= failed) && states.Count > 0) _failedArmyOptions.Remove(name);
+                else status = "Unknown";
+            }
+            item.Header = label + " — " + status;
+            item.IsEnabled = states.Count > 0;
+            var details = Skua.Core.Services.ArmyOptionFeedback.Describe(states.Select(s => s.State).ToArray(), name,
+                _pendingArmyOptions.TryGetValue(name, out var request) ? request.Target : null,
+                _pendingArmyOptions.TryGetValue(name, out request) ? request.Sent : null);
+            ToolTip.SetTip(item, new ScrollViewer { MaxHeight = 300, MaxWidth = 420,
+                Content = new TextBlock { Text = details, TextWrapping = TextWrapping.Wrap } });
+            if (item.Icon is MaterialIcon icon) icon.Foreground = status switch {
+                "On" => Brush.Parse("#22C55E"), "Off" => Brush.Parse("#EF4444"),
+                "Mixed" or "Pending" => Brush.Parse("#F59E0B"), _ => Brush.Parse("#94A3B8")
+            };
+        }
+    }
+    private void ArmyOption_Click(object? sender, RoutedEventArgs e)
+    {
+        if (sender is not MenuItem item || item.Tag is not string name) return;
+        var states = ArmyStates();
+        if (states.Count == 0) return;
+        bool target = !states.All(s => s.State?.Options.TryGetValue(name, out bool value) == true && value);
+        int command = ArmyOptionFeedback.Options.Single(o => o.Name == name).Command;
+        _pendingArmyOptions[name] = (target, DateTime.UtcNow);
+        _failedArmyOptions.Remove(name);
+        foreach (var (tab, _) in states)
+            if (tab.ChildHwnd != IntPtr.Zero) PostMessage(tab.ChildHwnd, WM_SKUA_SET_OPTION, new IntPtr(command), new IntPtr(target ? 1 : 0));
+        RefreshArmyOptions();
+        e.Handled = true;
+    }
+}
