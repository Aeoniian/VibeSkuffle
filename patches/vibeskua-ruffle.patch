@@ -0,0 +1,147 @@
+using Skua.Core.Services;
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Net.Http;
+using System.Security.Cryptography;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+using System.Threading.Tasks;
+
+namespace Skua.Manager.Avalonia.Services;
+
+public sealed class PortableClientUpdater
+{
+    public sealed record Release(string Tag, string Name, string Notes, string Url, string? Digest, long Size);
+    public Release? Available { get; private set; }
+    private readonly Func<Task<string>> _fetchReleases;
+    public PortableClientUpdater(Func<Task<string>>? fetchReleases = null) => _fetchReleases = fetchReleases ?? (() => Http.GetStringAsync("https://api.github.com/repos/Aeoniian/VibeSkuffle/releases?per_page=100"));
+    private static readonly HttpClient Http = CreateHttp();
+    private static HttpClient CreateHttp()
+    {
+        var client = new HttpClient { Timeout = TimeSpan.FromMinutes(10) };
+        client.DefaultRequestHeaders.UserAgent.ParseAdd("VibeSkuffle-Updater/1.0");
+        return client;
+    }
+    public static string InstalledVersion
+    {
+        get
+        {
+            string path = Path.Combine(AppContext.BaseDirectory, "release-version.txt");
+            return File.Exists(path) ? File.ReadAllText(path).Trim() : "v1.0.0-beta8";
+        }
+    }
+    public static int CompareVersions(string left, string right)
+    {
+        static int[] Numbers(string value) => Regex.Matches(value, @"\d+").Select(m => int.Parse(m.Value)).ToArray();
+        int[] a = Numbers(left), b = Numbers(right);
+        // Compare the three release numbers, then stable > beta; compare beta/hotfix numerically.
+        for (int i = 0; i < 3; i++)
+        {
+            int cmp = (i < a.Length ? a[i] : 0).CompareTo(i < b.Length ? b[i] : 0);
+            if (cmp != 0) return cmp;
+        }
+        bool ap = IsPreview(left), bp = IsPreview(right);
+        if (ap != bp) return ap ? -1 : 1;
+        static int Stage(string value) => value.Contains("dev", StringComparison.OrdinalIgnoreCase) ? -1 : value.Contains("alpha", StringComparison.OrdinalIgnoreCase) ? 0 : value.Contains("beta", StringComparison.OrdinalIgnoreCase) ? 1 : value.Contains("rc", StringComparison.OrdinalIgnoreCase) ? 2 : 3;
+        if (ap && bp && Stage(left) != Stage(right)) return Stage(left).CompareTo(Stage(right));
+        for (int i = 3; i < Math.Max(a.Length, b.Length); i++)
+        {
+            int cmp = (i < a.Length ? a[i] : 0).CompareTo(i < b.Length ? b[i] : 0);
+            if (cmp != 0) return cmp;
+        }
+        bool ad = left.Contains("-dev", StringComparison.OrdinalIgnoreCase), bd = right.Contains("-dev", StringComparison.OrdinalIgnoreCase);
+        return ad == bd ? 0 : ad ? -1 : 1;
+    }
+    public void ClearAvailable() => Available = null;
+    public async Task Check(bool includePreviews = false)
+    {
+        Available = null;
+        string json = await _fetchReleases();
+        Available = SelectRelease(json, InstalledVersion, includePreviews);
+    }
+    public static bool IsPreview(string value) => Regex.IsMatch(value, @"(?i)(?:^|[-\s])(?:beta|alpha|rc|dev)(?=\d|\.|\s|$)");
+    public static string? ReleaseVersion(string value)
+    {
+        var match = Regex.Match(value.Trim(), @"(?i)^(?:VibeSkuffle\s+)?v?(\d+\.\d+\.\d+(?:-(?:beta|alpha|rc|dev)\d*(?:\.\d+)*)?)(?:\s+Stable)?$");
+        if (match.Success) return Regex.Matches(match.Groups[1].Value, @"\d+").All(m => int.TryParse(m.Value, out _)) ? match.Groups[1].Value : null;
+        match = Regex.Match(value.Trim(), @"(?i)^Beta(\d+(?:\.\d+)*)$");
+        return match.Success && Regex.Matches(match.Groups[1].Value, @"\d+").All(m => int.TryParse(m.Value, out _)) ? "1.0.0-beta" + match.Groups[1].Value : null;
+    }
+    public static Release? SelectRelease(string json, string installed, bool includePreviews)
+    {
+        Release? selected = null;
+        string current = ReleaseVersion(installed) ?? throw new InvalidDataException("Installed version is not recognized.");
+        using var data = JsonDocument.Parse(json);
+        foreach (JsonElement release in data.RootElement.EnumerateArray())
+        {
+            if (release.GetProperty("draft").GetBoolean()) continue;
+            string tag = release.GetProperty("tag_name").GetString() ?? "";
+            string name = release.GetProperty("name").GetString() ?? tag;
+            string? version = ReleaseVersion(tag);
+            // Reject ambiguous metadata; legacy Beta tags and their full release names normalize identically.
+            if (version is null || (ReleaseVersion(name) is string named && CompareVersions(version, named) != 0)) continue;
+            bool preview = release.GetProperty("prerelease").GetBoolean() || IsPreview(tag) || IsPreview(name);
+            if (!includePreviews && preview) continue;
+            if (CompareVersions(version, current) <= 0 || (selected != null && CompareVersions(version, selected.Name) <= 0)) continue;
+            foreach (JsonElement asset in release.GetProperty("assets").EnumerateArray())
+            {
+                string file = asset.GetProperty("name").GetString() ?? "";
+                if (!file.StartsWith("VibeSkuffle-", StringComparison.OrdinalIgnoreCase) || !file.EndsWith("-win-x64.zip", StringComparison.OrdinalIgnoreCase)) continue;
+                string url = asset.GetProperty("browser_download_url").GetString() ?? "";
+                if (!url.StartsWith("https://github.com/Aeoniian/VibeSkuffle/releases/download/", StringComparison.OrdinalIgnoreCase)) continue;
+                selected = new(tag, version, release.GetProperty("body").GetString() ?? "", url,
+                    asset.TryGetProperty("digest", out var digest) ? digest.GetString() : null, asset.GetProperty("size").GetInt64());
+                break;
+            }
+        }
+        return selected;
+    }
+    public async Task<string> DownloadAndStage(IProgress<int> progress)
+    {
+        Release release = Available ?? throw new InvalidOperationException("Check for updates first.");
+        string job = Path.Combine(Path.GetTempPath(), "VibeSkuffleUpdate", Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(job);
+        string archive = Path.Combine(job, "update.zip");
+        using (var response = await Http.GetAsync(release.Url, HttpCompletionOption.ResponseHeadersRead))
+        {
+            response.EnsureSuccessStatusCode();
+            await using Stream source = await response.Content.ReadAsStreamAsync();
+            await using FileStream target = File.Create(archive);
+            byte[] buffer = new byte[81920]; long total = 0; int count;
+            while ((count = await source.ReadAsync(buffer)) > 0)
+            {
+                total += count;
+                if (total > 600_000_000) throw new InvalidDataException("Update download exceeds maximum size.");
+                await target.WriteAsync(buffer.AsMemory(0, count));
+                progress.Report(release.Size > 0 ? (int)Math.Min(99, total * 100 / release.Size) : 0);
+            }
+            if (total != release.Size) throw new InvalidDataException("Incomplete update download.");
+        }
+        if (release.Digest?.StartsWith("sha256:", StringComparison.OrdinalIgnoreCase) == true)
+        {
+            await using FileStream file = File.OpenRead(archive);
+            string hash = Convert.ToHexString(await SHA256.HashDataAsync(file));
+            if (!hash.Equals(release.Digest[7..], StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException("Release download hash mismatch.");
+        }
+        string staged = Path.Combine(job, "staged");
+        PortableUpdatePackage.Manifest manifest = await Task.Run(() => PortableUpdatePackage.Stage(archive, staged));
+        if (CompareVersions(manifest.Version, release.Name) != 0) throw new InvalidDataException("Package version does not match the release.");
+        progress.Report(100);
+        return job;
+    }
+
+    public static void StartInstaller(string job)
+    {
+        string script = Path.Combine(AppContext.BaseDirectory, "client-update.ps1");
+        if (!File.Exists(script)) throw new FileNotFoundException("The update helper is missing. Reinstall VibeSkuffle.");
+        string helper = Path.Combine(job, "install.ps1");
+        File.Copy(script, helper);
+        var start = new ProcessStartInfo("powershell.exe") { UseShellExecute = false, CreateNoWindow = true, WindowStyle = ProcessWindowStyle.Hidden };
+        foreach (string arg in new[] { "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", helper, "-InstallDirectory", AppContext.BaseDirectory, "-JobDirectory", job, "-ManagerProcessId", Environment.ProcessId.ToString() })
+            start.ArgumentList.Add(arg);
+        _ = Process.Start(start) ?? throw new InvalidOperationException("Could not start the update helper.");
+    }
+}
