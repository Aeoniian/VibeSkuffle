+    private void StopSession()
+    {
+        Session? old = _session;
+        _session = null;
+        if (old is null)
+            return;
+        try
+        {
+            if (old.Connected.IsSet)
+                Send(old, new JObject { ["t"] = "quit" });
+        }
+        catch { /* ignored */ }
+        old.Cancel.Cancel();
+        FailPending(old);
+        try
+        {
+            if (old.Process is { HasExited: false } p && !p.WaitForExit(1500))
+                p.Kill(true);
+        }
+        catch { /* ignored */ }
+        old.Dispose();
+        _control?.SetGameWindow(IntPtr.Zero);
+    }
