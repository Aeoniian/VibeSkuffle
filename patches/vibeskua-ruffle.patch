diff --git a/Skua.Manager.Avalonia/client-update.ps1 b/Skua.Manager.Avalonia/client-update.ps1
new file mode 100644
--- /dev/null
+++ b/Skua.Manager.Avalonia/client-update.ps1
@@ -0,0 +1,105 @@
+param(
+    [Parameter(Mandatory=$true)][string]$InstallDirectory,
+    [Parameter(Mandatory=$true)][string]$JobDirectory,
+    [int]$ManagerProcessId = 0,
+    [switch]$SkipProcessManagement,
+    [switch]$NoRestart,
+    [int]$TestFailAfterCopy = 0
+)
+$ErrorActionPreference = 'Stop'
+$installRoot = [IO.Path]::GetFullPath($InstallDirectory).TrimEnd('\')
+$jobRoot = [IO.Path]::GetFullPath($JobDirectory).TrimEnd('\')
+$stageRoot = Join-Path $jobRoot 'staged'
+$backupRoot = Join-Path $jobRoot 'rollback'
+$logFile = Join-Path $jobRoot 'result.txt'
+$changed = [Collections.Generic.List[object]]::new()
+$committed = $false
+function Get-SafeTarget([string]$relative) {
+    $normal = $relative.Replace('\','/')
+    if ([IO.Path]::IsPathRooted($normal) -or $normal -match '(^|/)\.{1,2}(/|$)|:|//') { throw "Unsafe update path: $relative" }
+    $allowed = $normal -match '^(?i:Assemblies)/[^:]+\.(?i:dll|so|dylib)$' -or
+        $normal -match '^(?i:ruffle)/(?:Mugetsu\.exe|[^:]+\.dll)$' -or
+        $normal -match '^(?i:plugins)/(?:ButlerV5|DailyTracker|Skua\.Plugin\.DailyTracker|Skua\.Plugin\.Cosmetics)\.dll$' -or
+        $normal -match '^(?i:VibeSkuffle(?:\.Manager)?\.(?:exe|dll|deps\.json|runtimeconfig\.json)|skua\.swf|use-ruffle\.txt|Velopack\.dll|build-info\.txt|release-version\.txt|client-update\.ps1)$'
+    if (!$allowed) { throw "Protected update path: $relative" }
+    $target = [IO.Path]::GetFullPath((Join-Path $installRoot $relative))
+    if (!$target.StartsWith($installRoot + '\',[StringComparison]::OrdinalIgnoreCase)) { throw 'Update escaped installation folder.' }
+    $check = $target
+    while ($check -and $check.StartsWith($installRoot,[StringComparison]::OrdinalIgnoreCase)) {
+        if ((Test-Path -LiteralPath $check) -and ((Get-Item -LiteralPath $check -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw "Linked update destination: $check" }
+        if ($check -eq $installRoot) { break }
+        $check = Split-Path -Parent $check
+    }
+    return $target
+}
+try {
+    $manifest = Get-Content -LiteralPath (Join-Path $stageRoot 'vibeskuffle-update.json') -Raw | ConvertFrom-Json
+    $files = @($manifest.Files.PSObject.Properties)
+    if ($files.Count -eq 0) { throw 'Empty update manifest.' }
+    $seen = @{}
+    foreach ($file in $files) {
+        $target = Get-SafeTarget $file.Name
+        if ($seen.ContainsKey($target)) { throw 'Duplicate update destination.' }
+        $seen[$target] = $true
+        $source = Join-Path $stageRoot $file.Name
+        if (!(Test-Path -LiteralPath $source -PathType Leaf)) { throw "Missing update file: $($file.Name)" }
+        if ((Get-FileHash -LiteralPath $source -Algorithm SHA256).Hash -ne $file.Value) { throw "Update hash mismatch: $($file.Name)" }
+    }
+    if (!$SkipProcessManagement) {
+        if ($ManagerProcessId -gt 0) {
+            $manager = Get-Process -Id $ManagerProcessId -ErrorAction SilentlyContinue
+            if ($manager -and !$manager.WaitForExit(60000)) { throw 'Manager did not close. No files changed.' }
+        }
+        $clients = @(Get-Process -Name VibeSkuffle -ErrorAction SilentlyContinue | Where-Object {
+            try { [IO.Path]::GetDirectoryName($_.MainModule.FileName).Equals($installRoot,[StringComparison]::OrdinalIgnoreCase) } catch { $false }
+        })
+        foreach ($client in $clients) { $null = $client.CloseMainWindow() }
+        foreach ($client in $clients) {
+            if (!$client.WaitForExit(30000)) { throw 'A client is still running. Close it and retry the update. No files changed.' }
+        }
+    }
+    New-Item -ItemType Directory -Force -Path $backupRoot | Out-Null
+    foreach ($file in $files) {
+        $target = Get-SafeTarget $file.Name
+        $backup = Join-Path $backupRoot $file.Name
+        if (Test-Path -LiteralPath $target) {
+            New-Item -ItemType Directory -Force -Path (Split-Path -Parent $backup) | Out-Null
+            Copy-Item -LiteralPath $target -Destination $backup
+        }
+    }
+    $copied = 0
+    foreach ($file in $files) {
+        $target = Get-SafeTarget $file.Name
+        $backup = Join-Path $backupRoot $file.Name
+        $changed.Add(@{Target=$target; Backup=$backup; Existed=(Test-Path -LiteralPath $target)})
+        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $target) | Out-Null
+        Copy-Item -LiteralPath (Join-Path $stageRoot $file.Name) -Destination $target -Force
+        $copied++
+        if ($TestFailAfterCopy -gt 0 -and $copied -ge $TestFailAfterCopy) { throw 'Injected update failure for rollback test.' }
+    }
+    $committed = $true
+    "Update installed: $($manifest.Version). Rollback files: $backupRoot" | Set-Content -LiteralPath $logFile
+}
+catch {
+    $problem = $_.Exception.Message
+    $rollbackProblems = @()
+    for ($index=$changed.Count-1; $index -ge 0; $index--) {
+        $item = $changed[$index]
+        try {
+            if ($item.Existed) { Copy-Item -LiteralPath $item.Backup -Destination $item.Target -Force }
+            elseif (Test-Path -LiteralPath $item.Target) { Remove-Item -LiteralPath $item.Target -Force }
+        }
+        catch { $rollbackProblems += $_.Exception.Message }
+    }
+    "Update failed: $problem`r`nRollback errors: $($rollbackProblems -join '; ')`r`nBackups: $backupRoot" | Set-Content -LiteralPath $logFile
+    if (!$NoRestart) {
+        Add-Type -AssemblyName PresentationFramework
+        [Windows.MessageBox]::Show("Update failed: $problem`nDetails: $logFile",'VibeSkuffle update') | Out-Null
+    }
+}
+finally {
+    if (!$NoRestart -and (Test-Path -LiteralPath (Join-Path $installRoot 'VibeSkuffle.Manager.exe'))) {
+        Start-Process -FilePath (Join-Path $installRoot 'VibeSkuffle.Manager.exe') -WorkingDirectory $installRoot -WindowStyle Hidden
+    }
+}
+if (!$committed) { exit 1 }
