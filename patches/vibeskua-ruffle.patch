@@ -0,0 +1,28 @@
+using System;
+using System.Collections.Generic;
+using System.Threading;
+using System.Threading.Tasks;
+namespace Skua.Manager.Avalonia.Services;
+
+public static class LaunchSequence
+{
+    public static async Task Run<T>(IReadOnlyList<T> accounts, int seconds, Func<T, bool> launch,
+        Action<int, int> progress, CancellationToken token, Func<TimeSpan, CancellationToken, Task>? delay = null)
+    {
+        delay ??= Task.Delay;
+        int success = 0;
+        for (int i = 0; i < accounts.Count; i++)
+        {
+            token.ThrowIfCancellationRequested();
+            if (launch(accounts[i])) success++;
+            progress(success, i + 1);
+            if (i + 1 < accounts.Count)
+            {
+                // Yield even at zero delay so Cancel remains usable between launches.
+                await Task.Yield();
+                token.ThrowIfCancellationRequested();
+                if (seconds > 0) await delay(TimeSpan.FromSeconds(Math.Clamp(seconds,0,60)), token);
+            }
+        }
+    }
+}
diff --git a/Skua.Manager.Avalonia/Services/PortableClientUpdater.cs b/Skua.Manager.Avalonia/Services/PortableClientUpdater.cs
