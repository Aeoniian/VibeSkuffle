+    public void RestartClient(bool runScript)
+    {
+        try
+        {
+            // Tell the tab window which script to bring back (the same file it reads after a crash).
+            string script = CommunityToolkit.Mvvm.DependencyInjection.Ioc.Default.GetService<IScriptManager>()?.LoadedScript ?? "";
+            string dir = Path.Combine(Path.GetTempPath(), "VibeSkuaTabs");
