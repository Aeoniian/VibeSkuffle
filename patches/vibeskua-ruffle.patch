diff --git a/Skua.Manager.Avalonia/Services/SupportReport.cs b/Skua.Manager.Avalonia/Services/SupportReport.cs
new file mode 100644
index 0000000..2b7983c
--- /dev/null
+++ b/Skua.Manager.Avalonia/Services/SupportReport.cs
@@ -0,0 +1,81 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Globalization;
+
+namespace Skua.Manager.Avalonia.Services;
+
+/// <summary>Allowlisted diagnostic summary. Raw log text never leaves this collector.</summary>
+public static class SupportReport
+{
+    private const int TailBytes = 64 * 1024;
+    public static async Task<string> Generate(string directory, CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        var report = new StringBuilder("VibeSkuffle support report\n");
+        string version = "Unavailable";
+        try { string raw = (await ReadTail(Path.Combine(directory, "release-version.txt"), token)).Trim(); if (Regex.IsMatch(raw, @"^v?\d+\.\d+\.\d+(?:-[a-zA-Z0-9.]+)?$")) version = raw; } catch (OperationCanceledException) { throw; } catch { }
+        report.AppendLine("Client: " + version);
+        report.AppendLine("OS: " + Environment.OSVersion.Version + " / " + RuntimeInformation.OSArchitecture);
+        report.AppendLine("Runtime: " + Environment.Version);
+        report.AppendLine("Renderer: " + (File.Exists(Path.Combine(directory, "ruffle", "Mugetsu.exe")) ? "Mugetsu (bundled)" : "Unavailable"));
+        try
+        {
+            await using var renderer = new FileStream(Path.Combine(directory, "ruffle", "Mugetsu.exe"), FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete, 81920, true);
+            report.AppendLine("Renderer SHA256: " + Convert.ToHexString(await SHA256.HashDataAsync(renderer, token)).ToLowerInvariant());
+        }
+        catch (OperationCanceledException) { throw; }
+        catch { report.AppendLine("Renderer fingerprint unavailable."); }
+        report.AppendLine("Script identity: unavailable in Manager; use Script Loader > Copy Script Details.");
+        report.AppendLine("Renderer tuning (recognized global values only):");
+        try
+        {
+            string text = await ReadTail(Path.Combine(directory, "ruffle-options.txt"), token);
+            foreach (string key in new[] { "RAYON_NUM_THREADS", "RUFFLE_POOL_IDLE_MB", "SKUA_HEADLESS_POOL_IDLE_MB", "SKUA_PARALLEL_MIN_SEGMENTS", "SKUA_PERF_DETAILS" })
+            {
+                var matches = Regex.Matches(text, @"(?m)^" + key + @"=([0-9]{1,5})\s*$");
+                report.AppendLine(key + "=" + (matches.Count == 0 ? "default / unspecified" : matches[^1].Groups[1].Value));
+            }
+        }
+        catch (OperationCanceledException) { throw; }
+        catch { report.AppendLine("Tuning file missing or unreadable."); }
+        report.AppendLine("Recent recovery summary (last 24 hours, within last 64 KiB; counts, no raw lines):");
+        try
+        {
+            string text = await ReadTail(Path.Combine(directory, "login-watchdog.log"), token);
+            report.AppendLine(SummarizeLog(text));
+        }
+        catch (OperationCanceledException) { throw; }
+        catch { report.AppendLine("Recovery log missing or unreadable."); }
+        token.ThrowIfCancellationRequested();
+        report.AppendLine("Account files, names, credentials, webhooks, script contents/options and raw logs are excluded. Unknown lines omitted. No files uploaded.");
+        return report.ToString();
+    }
+    public static string SummarizeLog(string text)
+    {
+        // Fixed category labels only: never echo a matching line or its captures.
+        DateTime now = DateTime.UtcNow;
+        string[] lines = text.Split('\n').TakeLast(400).Where(line => line.Length > 21 && line[20] == '[' &&
+            DateTime.TryParseExact(line[..19], "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var timestamp) &&
+            timestamp.ToUniversalTime() >= now.AddHours(-24) && timestamp.ToUniversalTime() <= now.AddMinutes(2)).ToArray();
+        var categories = new[] { ("Recovery attempts", "starting recovery"), ("Returned to game", "in game again after"), ("Rescue attempts", "asking the other accounts for help"), ("Rescue failures", "rescue failed:"), ("Script restart failures", "script restart failed") };
+        return string.Join("\n", categories.Select(c => c.Item1 + ": " + lines.Count(l => l.Contains(c.Item2, StringComparison.OrdinalIgnoreCase))))
+            + "\nUnrecognized, undated and older text omitted; at most 400 trailing lines summarized. Counts describe matching log text, not confirmed diagnoses.";
+    }
+    private static async Task<string> ReadTail(string path, CancellationToken token)
+    {
+        await using var file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete, 4096, true);
+        bool truncated = file.Length > TailBytes;
+        file.Seek(Math.Max(0, file.Length - TailBytes), SeekOrigin.Begin);
+        byte[] data = new byte[TailBytes]; int total = 0, count;
+        while (total < data.Length && (count = await file.ReadAsync(data.AsMemory(total), token)) > 0) total += count;
+        string value = Encoding.UTF8.GetString(data, 0, total);
+        return truncated ? value[(value.IndexOf('\n') + 1)..] : value;
+    }
+}
