+        }
+        catch { }
+        Trace.WriteLine("Restarting the whole client (login watchdog).");
+        _disposed = true; // no "the game window closed" handling on the way out
+        if (_session is { } session)
+            KillPlayer(session);
+        // A non-zero exit code: the tab window treats it like a crash and starts this account again.
+        // If shutting down hangs, kill the process (also a non-zero exit code).
+        new Thread(() => { Thread.Sleep(5000); try { Process.GetCurrentProcess().Kill(); } catch { } }) { IsBackground = true }.Start();
+        Environment.Exit(75);
