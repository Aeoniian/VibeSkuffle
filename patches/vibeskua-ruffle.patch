+            if (!File.Exists(file))
+                return args;
+            string[] lines = File.ReadAllLines(file);
+            File.Delete(file);
+            string script = lines.Length > 0 ? lines[0].Trim() : "";
+            bool running = lines.Length > 1 && lines[1].Trim() == "1";
+            if (script.Length == 0 || !File.Exists(script))
+                return args;
+            List<string> result = new();
