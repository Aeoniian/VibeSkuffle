+
+    private static int _sessionCounter;
+
+    private void RunSession(Session session)
+    {
+        try
+        {
+            Task.WaitAll(new[]
+            {
+                session.ToRuffle.WaitForConnectionAsync(session.Cancel.Token),
+                session.FromRuffle.WaitForConnectionAsync(session.Cancel.Token),
+            });
+            session.Connected.Set();
+            Trace.WriteLine($"Ruffle connected (pipe {session.Name}).");
+
+            byte[] header = new byte[4];
+            while (!session.Cancel.IsCancellationRequested)
+            {
+                if (!ReadExactly(session.FromRuffle, header))
+                    break;
+                int length = BitConverter.ToInt32(header, 0);
+                byte[] body = new byte[length];
+                if (!ReadExactly(session.FromRuffle, body))
+                    break;
+                HandleMessage(session, JObject.Parse(Encoding.UTF8.GetString(body)));
+            }
+        }
+        catch (Exception ex) when (ex is OperationCanceledException || ex is ObjectDisposedException
+                                   || ex is IOException || (ex is AggregateException ae && ae.InnerExceptions.All(e => e is OperationCanceledException or IOException)))
+        {
+        }
+        catch (Exception ex)
+        {
+            Trace.WriteLine($"Ruffle pipe error: {ex}");
+        }
+        finally
+        {
+            FailPending(session);
+        }
+    }
+
+    private static bool ReadExactly(Stream stream, byte[] buffer)
+    {
+        int read = 0;
+        while (read < buffer.Length)
+        {
+            int n = stream.Read(buffer, read, buffer.Length - read);
+            if (n <= 0)
+                return false;
+            read += n;
+        }
+        return true;
+    }
+
+    private void HandleMessage(Session session, JObject message)
+    {
