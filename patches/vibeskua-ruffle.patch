--- /dev/null
+++ b/Skua.Core/Services/ScriptIdentity.cs
@@ -0,0 +1,36 @@
+using System.Security.Cryptography;
+using System.Text.RegularExpressions;
+
+namespace Skua.Core.Services;
+
+/// <summary>Read-only, on-demand identity for the top-level script, never its contents or options.</summary>
+public static class ScriptIdentity
+{
+    public static string SafePath(string path, string scriptsRoot)
+    {
+        string full = Path.GetFullPath(path), root = Path.GetFullPath(scriptsRoot).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+        string label = full.StartsWith(root, StringComparison.OrdinalIgnoreCase) ? "<Scripts>/" + Path.GetRelativePath(root, full).Replace('\\', '/') : "<External>/" + Path.GetFileName(full);
+        string user = Environment.UserName;
+        return string.IsNullOrEmpty(user) ? label : label.Replace(user, "<user>", StringComparison.OrdinalIgnoreCase);
+    }
+    public static async Task<string> Describe(string path, string root, string version, CancellationToken token = default)
+    {
+        string header = $"VibeSkuffle {Regex.Replace(version, @"[^A-Za-z0-9.\-]", "")}\nScript: {SafePath(path, root)}\n";
+        try
+        {
+            for (int attempt = 0; attempt < 2; attempt++)
+            {
+                token.ThrowIfCancellationRequested();
+                var before = new FileInfo(path); long size = before.Length; DateTime written = before.LastWriteTimeUtc;
+                await using var file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete, 81920, true);
+                string hash = Convert.ToHexString(await SHA256.HashDataAsync(file, token)).ToLowerInvariant();
+                var after = new FileInfo(path);
+                if (after.Exists && after.Length == size && after.LastWriteTimeUtc == written)
+                    return header + $"SHA256 (top-level file only): {hash}\nLast write UTC: {written:O}\nIncluded helpers are not fingerprinted.";
+            }
+            return header + "Fingerprint unavailable: file changed while reading.";
+        }
+        catch (OperationCanceledException) { throw; }
+        catch { return header + "Fingerprint unavailable: file missing or unreadable."; }
+    }
+}
diff --git a/Skua.Core/Services/UltrasScriptInstaller.cs b/Skua.Core/Services/UltrasScriptInstaller.cs
new file mode 100644
index 0000000..3513cd6
--- /dev/null
+++ b/Skua.Core/Services/UltrasScriptInstaller.cs
@@ -0,0 +1,116 @@
+using System.IO.Compression;
+using System.Net.Http.Headers;
+using System.Security.Cryptography;
+using System.Text;
+using Skua.Core.Models;
+
+namespace Skua.Core.Services;
+
+/// <summary>Installs only UltrasLW, independently of the ordinary Skua script updater.</summary>
+public static class UltrasScriptInstaller
+{
+    public const string DownloadUrl = "https://github.com/l0newolf12/UltrasLW/archive/refs/heads/main.zip";
+    private const long MaximumBytes = 128 * 1024 * 1024;
+    private static readonly HttpClient Client = new() { Timeout = TimeSpan.FromMinutes(5) };
+
+    public static async Task InstallAsync(IProgress<string>? progress = null, CancellationToken cancellationToken = default)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Get, DownloadUrl);
+        request.Headers.CacheControl = new CacheControlHeaderValue { NoCache = true, NoStore = true };
+        progress?.Report("Downloading the latest UltrasLW...");
+        using var response = await Client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, cancellationToken).ConfigureAwait(false);
+        response.EnsureSuccessStatusCode();
+        if (response.Content.Headers.ContentLength > MaximumBytes) throw new InvalidDataException("UltrasLW download is too large.");
+        using var archive = new MemoryStream();
+        using var input = await response.Content.ReadAsStreamAsync(cancellationToken).ConfigureAwait(false);
+        byte[] buffer = new byte[81920];
+        int read;
+        while ((read = await input.ReadAsync(buffer, cancellationToken).ConfigureAwait(false)) > 0)
+        {
+            if (archive.Length + read > MaximumBytes) throw new InvalidDataException("UltrasLW download is too large.");
+            await archive.WriteAsync(buffer.AsMemory(0, read), cancellationToken).ConfigureAwait(false);
+        }
+        archive.Position = 0;
+        // Mutex ownership stays on a single worker thread through extraction and the directory swap.
+        await Task.Run(() => InstallArchive(archive, ClientFileSources.SkuaScriptsDIR, progress, cancellationToken), cancellationToken).ConfigureAwait(false);
+    }
+
+    public static void InstallArchive(Stream stream, string scriptsDirectory, IProgress<string>? progress = null, CancellationToken cancellationToken = default)
+    {
+        string scripts = Path.GetFullPath(scriptsDirectory);
+        Directory.CreateDirectory(scripts);
+        string destination = Path.Combine(scripts, "UltrasLW");
+        string hash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(destination.ToUpperInvariant())));
+        using var mutex = new Mutex(false, "VibeSkuffle.UltrasLW." + hash);
+        bool held;
+        try { held = mutex.WaitOne(0); } catch (AbandonedMutexException) { held = true; }
+        if (!held) throw new IOException("UltrasLW is already being installed by another client. Try again when it finishes.");
+        string staging = Path.Combine(scripts, ".UltrasLW-install-" + Guid.NewGuid().ToString("N"));
+        string backup = Path.Combine(scripts, ".UltrasLW-backup-" + Guid.NewGuid().ToString("N"));
+        bool moved = false, installed = false;
+        try
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            if (Directory.Exists(destination) && (File.GetAttributes(destination) & FileAttributes.ReparsePoint) != 0)
+                throw new IOException("UltrasLW is a linked folder. Choose a regular scripts folder before updating.");
+            Directory.CreateDirectory(staging);
+            progress?.Report("Validating and extracting UltrasLW...");
+            using (var archive = new ZipArchive(stream, ZipArchiveMode.Read, leaveOpen: true))
+            {
+                long total = 0;
+                int scriptsFound = 0;
+                var paths = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                if (archive.Entries.Count is 0 or > 10000) throw new InvalidDataException("Invalid UltrasLW archive.");
+                foreach (var entry in archive.Entries)
+                {
+                    cancellationToken.ThrowIfCancellationRequested();
+                    string name = entry.FullName.Replace('\\', '/');
+                    if (!name.StartsWith("UltrasLW-main/", StringComparison.Ordinal) ||
+                        name.Split('/').Any(p => p is "." or ".." || p.Contains(':')) ||
+                        ((entry.ExternalAttributes >> 16) & 0xF000) == 0xA000)
+                        throw new InvalidDataException("Unexpected path in UltrasLW archive.");
+                    string relative = name["UltrasLW-main/".Length..];
+                    if (relative.Length == 0 || name.EndsWith('/')) continue;
+                    string target = Path.GetFullPath(Path.Combine(staging, relative));
+                    if (!target.StartsWith(staging + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) || !paths.Add(target))
+                        throw new InvalidDataException("Invalid or duplicate UltrasLW archive path.");
+                    total = checked(total + entry.Length);
+                    if (total > MaximumBytes) throw new InvalidDataException("UltrasLW expands beyond the size limit.");
+                    Directory.CreateDirectory(Path.GetDirectoryName(target)!);
+                    using var source = entry.Open();
+                    using var output = File.Create(target);
+                    byte[] buffer = new byte[81920];
+                    long written = 0;
+                    int read;
+                    while ((read = source.Read(buffer)) > 0)
+                    {
+                        cancellationToken.ThrowIfCancellationRequested();
+                        written += read;
+                        if (written > entry.Length) throw new InvalidDataException("Invalid UltrasLW file length.");
+                        output.Write(buffer, 0, read);
+                    }
+                    if (written != entry.Length) throw new InvalidDataException("Incomplete UltrasLW file.");
+                    if (target.EndsWith(".cs", StringComparison.OrdinalIgnoreCase)) scriptsFound++;
+                }
+                if (scriptsFound == 0) throw new InvalidDataException("The download contains no UltrasLW scripts.");
+            }
+            cancellationToken.ThrowIfCancellationRequested();
+            progress?.Report("Installing UltrasLW...");
+            if (Directory.Exists(destination)) { Directory.Move(destination, backup); moved = true; }
+            try { Directory.Move(staging, destination); installed = true; }
+            catch
+            {
+                if (moved) Directory.Move(backup, destination);
+                throw;
+            }
+            progress?.Report("UltrasLW updated. Open Search Scripts or browse the UltrasLW folder to select a script.");
+        }
+        finally
+        {
+            // All temporary paths are direct children created by this operation.
+            try { if (Directory.Exists(staging)) Directory.Delete(staging, true); } catch { }
+            if (installed && moved) try { Directory.Delete(backup, true); } catch { }
+            mutex.ReleaseMutex();
+        }
+    }
+}
