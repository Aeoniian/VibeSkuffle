+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using Skua.App.Avalonia.Flash;
+using Skua.App.Avalonia.Views;
+
+namespace Skua.App.Avalonia.Services;
+
+/// <summary>
+/// When the tab host (the window that holds every account's tab) crashes or is killed, every client in it
+/// goes down with it. Each client then starts itself again with the same login (and the script it had
+/// loaded or running), one at a time: the first one starts a new tab host, the rest join it as tabs.
+/// </summary>
+/// <remarks>
+/// Not when the host was closed on purpose (it leaves a "closing" marker and closes its clients first),
+/// and at most 3 times per account per 30 minutes so a host that keeps crashing can't loop forever.
+/// </remarks>
+public static class HostCrashRecovery
+{
+    // Held for the whole relaunch: the window closing and the host watcher can both get here, and the
+    // second one must wait (the app exits as soon as it returns).
+    private static readonly object Gate = new();
+    private static bool _done;
+    private static string Dir => Path.Combine(Path.GetTempPath(), "VibeSkuaTabs");
+
+    /// <summary>Called by the host when it is being closed on purpose.</summary>
+    public static void MarkHostClosing()
+    {
+        try
+        {
+            Directory.CreateDirectory(Dir);
+            File.WriteAllText(Path.Combine(Dir, $"host-{Environment.ProcessId}.closing"), DateTime.UtcNow.Ticks.ToString());
+            // Tidy up markers from earlier runs.
+            foreach (string old in Directory.GetFiles(Dir, "host-*.closing"))
+                if (DateTime.UtcNow - File.GetLastWriteTimeUtc(old) > TimeSpan.FromDays(1))
+                    try { File.Delete(old); } catch { }
+        }
+        catch { }
+    }
+
+    /// <summary>Called by a client when its host process is gone. Blocks until its relaunch is under way.</summary>
+    public static void OnHostGone(Process host)
+    {
+        Trace($"host {SafeId(host)} gone, checking");
+        lock (Gate)
+        {
+            if (_done)
+                return;
+            _done = true;
+            Relaunch(host);
+        }
+    }
+
+    private static void Relaunch(Process host)
+    {
+        try
+        {
+            int hostPid = host.Id;
+            int code = 0;
+            try { code = host.ExitCode; } catch { }
+            string marker = Path.Combine(Dir, $"host-{hostPid}.closing");
+            Trace($"host exit code {code}, marker {File.Exists(marker)}");
+            if (File.Exists(marker))
+                return; // closed on purpose
+            if (code == 0)
+                return; // a normal exit (Windows shutting down, sign out)
+
+            string[] args = ClientArgs();
+            string account = TabbedHostWindow.AccountKey(args);
+            Trace($"account known: {account.Length > 0}");
+            if (account.Length == 0)
+                return; // no saved login: nothing to log back in with
+            if (!AllowRelaunch(account))
+            {
+                Log(account, " the tab host keeps crashing (3 times in 30 minutes); not starting this account again.");
+                Skua.Core.Services.VibeAlerts.Send(account, "tab window keeps crashing", "The tab window crashed 3 times in 30 minutes; this account isn't being started again. Start it from the Manager when you can.");
+                return;
+            }
+
+            args = TabbedHostWindow.WithLastScript(args, Environment.ProcessId);
+            Log(account, $" the tab host closed unexpectedly (exit code {code}); starting this account again.");
+
+            // One client at a time, so only the first starts a new tab host and the others join it.
+            using var turn = new Mutex(false, @"Local\VibeSkuaRuffleHostRecovery");
+            bool owned = false;
+            try
+            {
+                try { owned = turn.WaitOne(TimeSpan.FromMinutes(3)); }
+                catch (AbandonedMutexException) { owned = true; }
+
+                bool hostRunning = HostRunning();
+                Process p = new();
+                p.StartInfo.FileName = Environment.ProcessPath ?? Process.GetCurrentProcess().MainModule?.FileName ?? "";
+                p.StartInfo.UseShellExecute = false;
+                p.StartInfo.WorkingDirectory = AppContext.BaseDirectory;
+                foreach (string arg in args)
+                    p.StartInfo.ArgumentList.Add(arg);
+                p.Start();
+                Trace($"started {p.Id} (host was running: {hostRunning})");
+
+                if (!hostRunning)
+                {
+                    // Wait for the new host to be up (its mutex exists and it listens for tabs).
+                    for (int i = 0; i < 60 && !HostRunning(); i++)
+                        Thread.Sleep(500);
+                    Thread.Sleep(4000);
+                }
+                else
+                {
+                    Thread.Sleep(2500);
+                }
+            }
+            finally
+            {
+                if (owned)
+                    try { turn.ReleaseMutex(); } catch { }
+            }
+        }
+        catch (Exception ex)
+        {
+            try { Log("?", $" couldn't start the account again after the tab host closed: {ex.Message}"); } catch { }
+        }
+    }
+
+    /// <summary>Step-by-step trace for diagnosing recovery (Build\host-recovery.log, kept small).</summary>
+    public static void Trace(string message)
+    {
+        try
+        {
+            string path = Path.Combine(AppContext.BaseDirectory, "host-recovery.log");
+            var info = new FileInfo(path);
+            if (info.Exists && info.Length > 200_000)
+                info.Delete();
+            lock (TraceLock)
+                File.AppendAllText(path, $"{DateTime.Now:yyyy-MM-dd HH:mm:ss.fff} [{Environment.ProcessId}] {message}{Environment.NewLine}");
+        }
+        catch { }
+    }
+
+    private static readonly object TraceLock = new();
+
+    private static bool HostRunning()
+    {
+        if (!Mutex.TryOpenExisting(FlashBackend.TabHostMutexName, out Mutex? m))
+            return false;
+        m.Dispose();
+        return true;
+    }
+
+    /// <summary>This client's own arguments without the tab host ones (--embed, --host-pid).</summary>
+    private static string[] ClientArgs()
+    {
+        string[] all = Environment.GetCommandLineArgs();
+        List<string> result = new();
+        for (int i = 1; i < all.Length; i++)
+        {
+            if (all[i] is "--embed" or "--host-pid")
+            {
+                i++;
+                continue;
+            }
+            result.Add(all[i]);
+        }
+        return result.ToArray();
+    }
+
+    private static bool AllowRelaunch(string account)
+    {
+        try
+        {
+            Directory.CreateDirectory(Dir);
+            string file = Path.Combine(Dir, $"host-recovery-{Sanitize(account)}.txt");
+            List<DateTime> times = File.Exists(file)
+                ? File.ReadAllLines(file).Select(l => long.TryParse(l, out long t) ? new DateTime(t, DateTimeKind.Utc) : DateTime.MinValue)
+                    .Where(t => DateTime.UtcNow - t < TimeSpan.FromMinutes(30)).ToList()
+                : new();
+            if (times.Count >= 3)
+                return false;
+            times.Add(DateTime.UtcNow);
+            File.WriteAllLines(file, times.Select(t => t.Ticks.ToString()));
+            return true;
+        }
+        catch
+        {
+            return true;
+        }
+    }
+
+    private static string SafeId(Process p)
+    {
+        try { return p.Id.ToString(); } catch { return "?"; }
+    }
+
+    private static string Sanitize(string s) => new(s.Select(c => char.IsLetterOrDigit(c) ? c : '_').ToArray());
+
+    private static void Log(string account, string message)
+    {
+        try
+        {
+            string path = Path.Combine(AppContext.BaseDirectory, "login-watchdog.log");
+            File.AppendAllText(path, $"{DateTime.Now:yyyy-MM-dd HH:mm:ss} [{account}] (client){message}{Environment.NewLine}");
+        }
+        catch { }
+    }
+}
