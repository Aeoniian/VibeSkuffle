+
+    public void RestartGamePlayer()
+    {
+        Dispatcher.UIThread.Post(() =>
+        {
+            if (_disposed)
+                return;
+            Trace.WriteLine("Restarting the Ruffle player (login watchdog).");
+            InitializeFlash();
+        });
