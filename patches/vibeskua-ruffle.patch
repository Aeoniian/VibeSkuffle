@@ -0,0 +1,58 @@
+using CommunityToolkit.Mvvm.DependencyInjection;
+using Skua.App.Avalonia.ViewModels;
+using Skua.Core.Interfaces;
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Skua.App.Avalonia.Flash;
+
+internal static class ClientQuickControls
+{
+    private static int _scriptAction;
+    public static string ScriptLabel
+    {
+        get
+        {
+            var manager = Ioc.Default.GetService<IScriptManager>();
+            string name = System.IO.Path.GetFileName(manager?.LoadedScript ?? "");
+            if (string.IsNullOrWhiteSpace(name)) return manager?.ScriptRunning == true ? "Script running" : "No script selected";
+            return $"{(manager?.ScriptRunning == true ? "Running" : "Selected")}: {name}";
+        }
+    }
+    public static async void Execute(string action)
+    {
+        try
+        {
+            var options = Ioc.Default.GetRequiredService<IScriptOption>();
+            var manager = Ioc.Default.GetRequiredService<IScriptManager>();
+            switch (action)
+            {
+                case "start":
+                    if (Interlocked.Exchange(ref _scriptAction, 1) != 0) return;
+                    try
+                    {
+                        if (!manager.ScriptRunning)
+                        {
+                            var loader = Ioc.Default.GetRequiredService<ScriptLoaderViewModel>();
+                            if (string.IsNullOrWhiteSpace(manager.LoadedScript)) loader.LoadScript();
+                            if (!string.IsNullOrWhiteSpace(manager.LoadedScript)) await loader.StartScriptAsync(manager.LoadedScript);
+                        }
+                    }
+                    finally { Volatile.Write(ref _scriptAction, 0); }
+                    break;
+                case "stop": await manager.StopScript(); break;
+                case "headless": options.HeadlessMode = !options.HeadlessMode; break;
+                case "lagkiller": options.LagKiller = !options.LagKiller; break;
+                case "restart":
+                    if (Ioc.Default.GetService<IFlashUtil>() is IRestartableGamePlayer player && player.CanRestartClient)
+                        await Task.Run(() => player.RestartClient(manager.ScriptRunning));
+                    break;
+            }
+        }
+        catch (Exception ex)
+        {
+            Ioc.Default.GetService<IDialogService>()?.ShowMessageBox(ex.Message, "Account control");
+        }
+    }
+}
