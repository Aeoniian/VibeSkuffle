+    /// <summary>A call with its own timeout: true if the game answered at all.</summary>
+    private bool Ping(Session session, TimeSpan timeout)
+    {
+        long id = Interlocked.Increment(ref _nextId);
+        var call = new PendingCall(session);
+        _pending[id] = call;
+        var request = new JObject { ["t"] = "call", ["id"] = id, ["n"] = "isTrue", ["a"] = new JArray() };
+        bool answered = Send(session, request) && call.Done.Wait(timeout);
+        _pending.TryRemove(id, out _);
+        return answered;
+    }
