+++ b/Skua.App.Avalonia/Flash/RuffleFlashUtil.PlayerSettings.cs
@@ -0,0 +1,292 @@
+namespace Skua.App.Avalonia.Flash;
+
+#if IS_WINDOWS
+using Dispatcher = global::Avalonia.Threading.Dispatcher;
+using Newtonsoft.Json.Linq;
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using WinForms = System.Windows.Forms;
+
+/// <summary>Mugetsu's settings as the game player last reported them.</summary>
+public sealed record PlayerSettings(bool Interpolation, bool FlashEdges, bool ShowFps, string Graphics);
+
+/// <summary>
+/// VibeSkuffle's Graphics menu: Mugetsu's own settings (edge smoothing, frame interpolation, FPS counter),
+/// the same for every account, and the graphics API chosen per account from the game's right-click menu.
+/// </summary>
+/// <remarks>
+/// A change is written to <c>%TEMP%\VibeSkuaTabs\mugetsu-settings.txt</c>; every client checks that file every
+/// 2 seconds and sends its player whatever differs, so all accounts follow. Mugetsu also saves the settings
+/// itself, so a game window started later already has them.
+/// </remarks>
+public sealed partial class RuffleFlashUtil
+{
+    public const string ApiVulkan = "vulkan", ApiDx12 = "dx12", ApiGl = "gl";
+
+    private static string SharedSettingsPath => Path.Combine(Path.GetTempPath(), "VibeSkuaTabs", "mugetsu-settings.txt");
+
+    private Timer? _settingsSync;
+    private Timer? _graphicsRevert;
+    private int _playerHellos;
+    private DateTime _sharedSettingsStamp = DateTime.MinValue;
+    private Dictionary<string, bool> _sharedSettings = new();
+
+    /// <summary>The player's settings, once it has reported them (null before that).</summary>
+    public PlayerSettings? CurrentPlayerSettings { get; private set; }
+
+    /// <summary>Raised (on any thread) when the player reports its settings.</summary>
+    public event Action? PlayerSettingsChanged;
+
+    public static string ApiName(string api) => api switch
+    {
+        ApiVulkan => "Vulkan",
+        ApiDx12 => "DirectX 12",
+        ApiGl => "OpenGL",
+        _ => "Automatic",
+    };
+
+    private void OnPlayerSettings(JObject message)
+    {
+        CurrentPlayerSettings = new PlayerSettings(
+            (bool?)message["interpolation"] ?? false,
+            (bool?)message["edges"] ?? true,
+            (bool?)message["fps"] ?? false,
+            (string?)message["graphics"] ?? "auto");
+        try { PlayerSettingsChanged?.Invoke(); } catch { }
+    }
+
+    /// <summary>
+    /// Changes a Mugetsu setting for every account: <c>"interpolation"</c>, <c>"edges"</c> (true = Flash-style,
+    /// false = MSAA) or <c>"fps"</c>.
+    /// </summary>
+    public void SetPlayerSettingForAll(string key, bool on)
+    {
+        try
+        {
+            Dictionary<string, bool> all = ReadSharedSettings() ?? new();
+            all[key] = on;
+            Directory.CreateDirectory(Path.GetDirectoryName(SharedSettingsPath)!);
+            string temp = SharedSettingsPath + $".{Environment.ProcessId}.tmp";
+            File.WriteAllLines(temp, all.Select(kv => $"{kv.Key}={(kv.Value ? 1 : 0)}"));
+            File.Move(temp, SharedSettingsPath, true);
+        }
+        catch (Exception ex)
+        {
+            Trace.WriteLine($"Graphics menu: couldn't save the setting for the other accounts: {ex.Message}");
+        }
+        // This account right away; the others within 2 seconds.
+        SendPlayerSetting(key, on);
+    }
+
+    /// <summary>Opens Mugetsu's log folder.</summary>
+    public void OpenPlayerLogFolder() => SendPlayerSetting("logs", true);
+
+    private void SendPlayerSetting(string key, bool on)
+    {
+        if (_session is { } session && session.Connected.IsSet)
+            Send(session, new JObject { ["t"] = "set", ["k"] = key, ["v"] = on });
+    }
+
+    private void StartPlayerSettingsSync()
+    {
+        _settingsSync ??= new Timer(_ => SyncPlayerSettings(), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
+        _sharedSettingsStamp = DateTime.MinValue; // a new game window: check it against the file again
+    }
+
+    private void SyncPlayerSettings()
+    {
+        try
+        {
+            if (_session is { } session && session.Connected.IsSet && !_disposed)
+            {
+                var manager = CommunityToolkit.Mvvm.DependencyInjection.Ioc.Default.GetService<Skua.Core.Interfaces.IScriptManager>();
+                var options = CommunityToolkit.Mvvm.DependencyInjection.Ioc.Default.GetService<Skua.Core.Interfaces.IScriptOption>();
+                Send(session, new JObject { ["t"] = "client_state", ["running"] = manager?.ScriptRunning == true, ["script_label"] = ClientQuickControls.ScriptLabel,
+                    ["headless"] = options?.HeadlessMode == true, ["lagkiller"] = options?.LagKiller == true });
+            }
+            if (_disposed || CurrentPlayerSettings is not { } current)
+                return;
+            DateTime stamp = File.Exists(SharedSettingsPath) ? File.GetLastWriteTimeUtc(SharedSettingsPath) : DateTime.MinValue;
+            if (stamp != _sharedSettingsStamp)
+            {
+                _sharedSettings = ReadSharedSettings() ?? new();
+                _sharedSettingsStamp = stamp;
+            }
+            foreach ((string key, bool wanted) in _sharedSettings)
+            {
+                bool now = key switch
+                {
+                    "interpolation" => current.Interpolation,
+                    "edges" => current.FlashEdges,
+                    "fps" => current.ShowFps,
+                    _ => wanted,
+                };
+                if (now != wanted)
+                {
+                    SendPlayerSetting(key, wanted);
+                    // Wait for the player's answer before sending more (it reports the new settings).
+                    CurrentPlayerSettings = current with
+                    {
+                        Interpolation = key == "interpolation" ? wanted : current.Interpolation,
+                        FlashEdges = key == "edges" ? wanted : current.FlashEdges,
+                        ShowFps = key == "fps" ? wanted : current.ShowFps,
+                    };
+                    current = CurrentPlayerSettings;
+                }
+            }
+        }
+        catch { /* try again in 2 seconds */ }
+    }
+
+    private static Dictionary<string, bool>? ReadSharedSettings()
+    {
+        try
+        {
+            if (!File.Exists(SharedSettingsPath))
+                return null;
+            var all = new Dictionary<string, bool>();
+            foreach (string line in File.ReadAllLines(SharedSettingsPath))
+            {
+                int eq = line.IndexOf('=');
+                if (eq > 0)
+                    all[line[..eq].Trim()] = line[(eq + 1)..].Trim() == "1";
+            }
+            return all;
+        }
+        catch
+        {
+            return null;
+        }
+    }
+
+    /// <summary>
+    /// The game's right-click menu asked for another graphics API: saved for this account in
+    /// ruffle-options.txt (<c>account: --graphics ...</c>) and the game window restarted with it. The
+    /// watchdog logs back in and starts the script again, as after any game window restart.
+    /// </summary>
+    private void ChooseGraphicsApi(string api)
+    {
+        if (api is not (ApiVulkan or ApiDx12 or ApiGl) || _disposed)
+            return;
+        string account = ThisAccount();
+        if (account.Length == 0)
+        {
+            WinForms.MessageBox.Show("This window has no account to save the choice for.", "Graphics API",
+                WinForms.MessageBoxButtons.OK, WinForms.MessageBoxIcon.Information);
+            return;
+        }
+        if (CurrentPlayerSettings?.Graphics == api)
+            return;
+        var answer = WinForms.MessageBox.Show(
+            $"Switch this account to {ApiName(api)}?\r\n\r\nIts game window restarts; it logs back in and starts its script again by itself.",
+            "Graphics API", WinForms.MessageBoxButtons.OKCancel, WinForms.MessageBoxIcon.Question);
+        if (answer != WinForms.DialogResult.OK)
+            return;
+        string? before = AccountGraphics(account); // this account's own line, if it had one
+        string previous = CurrentPlayerSettings?.Graphics ?? "auto";
+        try
+        {
+            SaveAccountGraphics(account, api);
+        }
+        catch (Exception ex)
+        {
+            WinForms.MessageBox.Show($"Couldn't save it in ruffle-options.txt:\r\n{ex.Message}", "Graphics API",
+                WinForms.MessageBoxButtons.OK, WinForms.MessageBoxIcon.Error);
+            return;
+        }
+        HealthLog($" switched to {ApiName(api)} graphics (right-click menu); restarting the game window.");
+        // If the game doesn't come up with it (the API doesn't work on this PC), go back by itself.
+        int hellos = Volatile.Read(ref _playerHellos);
+        _graphicsRevert?.Dispose();
+        _graphicsRevert = new Timer(_ => Dispatcher.UIThread.Post(() =>
+        {
+            if (_disposed || Volatile.Read(ref _playerHellos) != hellos)
+                return;
+            try
+            {
+                if (before is not null)
+                    SaveAccountGraphics(account, before);
+                else
+                    RemoveAccountGraphics(account);
+            }
+            catch { }
+            HealthLog($" {ApiName(api)} graphics didn't start within 90 seconds; going back to {ApiName(before ?? previous)}.");
+            Skua.Core.Services.VibeAlerts.Send(account, $"{ApiName(api)} graphics didn't work",
+                $"The game didn't start with {ApiName(api)}, so this account went back to {ApiName(before ?? previous)}.",
+                Skua.Core.Services.VibeAlerts.Level.Warning);
+            RestartGamePlayer();
+        }), null, TimeSpan.FromSeconds(90), Timeout.InfiniteTimeSpan);
+        RestartGamePlayer();
+    }
+
+    private static string OptionsPath => Path.Combine(AppContext.BaseDirectory, "ruffle-options.txt");
+
+    private static int AccountGraphicsLine(List<string> lines, string account) => lines.FindIndex(raw =>
+    {
+        string line = raw.Trim();
+        int colon = line.IndexOf(':');
+        return colon > 0 && !line.StartsWith('#') && !line.StartsWith('-')
+            && line[..colon].Trim().Equals(account, StringComparison.OrdinalIgnoreCase)
+            && line[(colon + 1)..].TrimStart().StartsWith("--graphics", StringComparison.OrdinalIgnoreCase);
+    });
+
+    /// <summary>The API on this account's own <c>--graphics</c> line, or null.</summary>
+    private static string? AccountGraphics(string account)
+    {
+        try
+        {
+            List<string> lines = File.Exists(OptionsPath) ? File.ReadAllLines(OptionsPath).ToList() : new();
+            int index = AccountGraphicsLine(lines, account);
+            if (index < 0)
+                return null;
+            string[] parts = lines[index][(lines[index].IndexOf(':') + 1)..].Split(' ', StringSplitOptions.RemoveEmptyEntries);
+            return parts.Length > 1 ? parts[1].ToLowerInvariant() : null;
+        }
+        catch
+        {
+            return null;
+        }
+    }
+
+    private static void RemoveAccountGraphics(string account)
+    {
+        List<string> lines = File.Exists(OptionsPath) ? File.ReadAllLines(OptionsPath).ToList() : new();
+        int index = AccountGraphicsLine(lines, account);
+        if (index < 0)
+            return;
+        lines.RemoveAt(index);
+        WriteOptions(lines);
+    }
+
+    private static void WriteOptions(List<string> lines)
+    {
+        string temp = OptionsPath + ".tmp";
+        File.WriteAllLines(temp, lines);
+        File.Move(temp, OptionsPath, true);
+    }
+
+    /// <summary>Replaces this account's <c>--graphics</c> line in ruffle-options.txt, or adds one.</summary>
+    private static void SaveAccountGraphics(string account, string api)
+    {
+        List<string> lines = File.Exists(OptionsPath) ? File.ReadAllLines(OptionsPath).ToList() : new();
+        string entry = $"{account}: --graphics {api}";
+        int index = AccountGraphicsLine(lines, account);
+        if (index >= 0)
+        {
+            lines[index] = entry;
+        }
+        else
+        {
+            if (!lines.Any(l => l.Contains("right-click the game", StringComparison.OrdinalIgnoreCase)))
+                lines.Add("# Graphics API per account (set by right-click the game -> Graphics API):");
+            lines.Add(entry);
+        }
+        WriteOptions(lines);
+    }
+}
