+    // ---- Value conversion (mirrors FlashUtil's XML conversion) ------------------------------------
+
+    /// <summary>Same mapping as <see cref="FlashUtil.ToFlashXml(object)"/>.</summary>
+    private static JToken ToJson(object? o)
+    {
+        switch (o)
+        {
+            case null:
+                return JValue.CreateNull();
+            case bool b:
+                return new JValue(b);
+            case double d:
+                return Number(d);
+            case float f:
+                return Number(f);
+            case long l:
+                return new JValue(l);
+            case int i:
+                return new JValue(i);
+            case ExpandoObject expando:
+                var fields = new JObject();
+                foreach (KeyValuePair<string, object?> kvp in (IDictionary<string, object?>)expando)
+                    fields[kvp.Key] = ToJson(kvp.Value);
+                return new JObject { ["$o"] = fields };
+            case Array array:
+                var list = new JArray();
+                foreach (object? el in array)
+                    list.Add(ToJson(el));
+                return list;
+            default:
+                return new JValue(o.ToString());
+        }
+    }
+
+    private static JToken Number(double d)
+    {
+        if (double.IsNaN(d))
+            return new JObject { ["$n"] = "NaN" };
+        if (double.IsInfinity(d))
+            return new JObject { ["$n"] = d > 0 ? "Infinity" : "-Infinity" };
+        return new JValue(d);
+    }
+
+    /// <summary>
+    /// Appends what <c>XElement.Value</c> gives for Flash's XML form of <paramref name="token"/>: the text of
+    /// strings and numbers, nothing for booleans, null and undefined, and the values of arrays and objects.
+    /// </summary>
+    private static void AppendFlashText(JToken token, StringBuilder text)
+    {
+        switch (token.Type)
+        {
+            case JTokenType.String:
+                text.Append(token.Value<string>());
+                break;
+            case JTokenType.Integer:
+                text.Append(token.Value<long>().ToString(CultureInfo.InvariantCulture));
+                break;
+            case JTokenType.Float:
+                double d = token.Value<double>();
+                text.Append(d == Math.Floor(d) && Math.Abs(d) < 1e15
+                    ? ((long)d).ToString(CultureInfo.InvariantCulture)
+                    : d.ToString("R", CultureInfo.InvariantCulture));
+                break;
+            case JTokenType.Array:
+                foreach (JToken item in token)
+                    AppendFlashText(item, text);
+                break;
+            case JTokenType.Object:
+                var obj = (JObject)token;
+                if (obj["$n"] is JValue special)
+                    text.Append((string?)special);
+                else if (!obj.ContainsKey("$u"))
+                    foreach (var (_, value) in (obj["$o"] as JObject) ?? obj)
+                        if (value is not null)
+                            AppendFlashText(value, text);
+                break;
+        }
+    }
+
+    /// <summary>Same mapping as <see cref="FlashUtil.FromFlashXml(XElement)"/>.</summary>
+    private static object FromJson(JToken token)
+    {
+        switch (token.Type)
+        {
+            case JTokenType.Integer:
+            case JTokenType.Float:
+                double d = token.Value<double>();
+                if (d == Math.Floor(d) && d >= int.MinValue && d <= int.MaxValue)
+                    return (int)d;
+                return (float)d;
+            case JTokenType.Boolean:
+                return token.Value<bool>();
+            case JTokenType.Null:
+                return null!;
+            case JTokenType.String:
+                return token.Value<string>()!;
+            case JTokenType.Array:
+                return token.Select(FromJson).ToArray();
+            case JTokenType.Object:
+                var obj = (JObject)token;
+                if (obj.ContainsKey("$u"))
+                    return string.Empty; // Flash's <undefined/> became "" as well.
+                if (obj["$n"] is JValue special)
+                    return (string?)special switch { "Infinity" => float.PositiveInfinity, "-Infinity" => float.NegativeInfinity, _ => float.NaN };
+                var expando = new ExpandoObject();
+                var dict = (IDictionary<string, object?>)expando;
+                foreach (var (key, value) in (obj["$o"] as JObject) ?? obj)
+                    dict[key] = value is null ? null : FromJson(value);
+                return expando;
+            default:
+                return token.ToString();
+        }
+    }
+
+    /// <summary>
+    /// The text <see cref="FlashUtil"/> would have read from Flash's XML answer (the first node of the
+    /// value element), or <see langword="null"/> where it got none (booleans, null, undefined).
+    /// One difference: strings come back exactly as the game has them, where the XML path returned
+    /// them XML-escaped (an item named "A &amp; B" came back as "A &amp;amp; B").
+    /// </summary>
+    private static string? ReturnText(JToken? token)
+    {
+        if (token is null)
+            return null;
+        switch (token.Type)
+        {
+            case JTokenType.String:
+                string s = token.Value<string>()!;
+                return s.Length == 0 ? null : s;
+            case JTokenType.Integer:
+                return token.Value<long>().ToString(CultureInfo.CurrentCulture);
+            case JTokenType.Float:
+                double d = token.Value<double>();
+                return d == Math.Floor(d) && Math.Abs(d) < 1e15
+                    ? ((long)d).ToString(CultureInfo.CurrentCulture)
+                    : d.ToString("R", CultureInfo.CurrentCulture);
+            case JTokenType.Object when token["$n"] is JValue special:
+                return (string?)special;
+            case JTokenType.Object when token["$u"] is not null:
+                return null;
+            case JTokenType.Array:
+            case JTokenType.Object:
+                return token.ToString(Formatting.None);
+            default:
+                return null;
+        }
+    }
+
+    public object FromFlashXml(XElement el)
+    {
+        switch (el.Name.ToString())
+        {
+            case "number":
+                return int.TryParse(el.Value, out int i) ? i : float.TryParse(el.Value, out float f) ? f : 0;
+            case "true":
+                return true;
+            case "false":
+                return false;
+            case "null":
+                return null!;
+            case "array":
+                return el.Elements().Select(e => FromFlashXml(e)).ToArray();
+            case "object":
+                var d = new ExpandoObject();
+                var dict = (IDictionary<string, object?>)d;
+                foreach (XElement e in el.Elements())
+                    dict[e.Attribute("id")!.Value] = FromFlashXml(e.Elements().First());
+                return d;
+            default:
+                return el.Value;
+        }
+    }
+
+    public IFlashObject<T> CreateFlashObject<T>(string path)
+    {
+        return new FlashObject<T>(Call<int>("lnkCreate", path), this);
+    }
+
+    public void Dispose()
+    {
+        _disposed = true;
+        try { StopSession(); } catch { /* ignored */ }
+    }
+
+    // ---- Plumbing ---------------------------------------------------------------------------
+
+    private sealed class PendingCall
+    {
+        public PendingCall(Session session) => Session = session;
+        public Session Session { get; }
+        public ManualResetEventSlim Done { get; } = new(false);
+        public JToken? Result { get; set; }
+    }
+
+    private sealed class Session : IDisposable
+    {
+        public Session(string name)
+        {
+            Name = name;
+            ToRuffle = new NamedPipeServerStream(name + "-c2r", PipeDirection.Out, 1, PipeTransmissionMode.Byte, PipeOptions.Asynchronous, 0, 64 * 1024);
+            FromRuffle = new NamedPipeServerStream(name + "-r2c", PipeDirection.In, 1, PipeTransmissionMode.Byte, PipeOptions.Asynchronous, 64 * 1024, 0);
+        }
+
+        public string Name { get; }
+        public NamedPipeServerStream ToRuffle { get; }
+        public NamedPipeServerStream FromRuffle { get; }
+        public Process? Process { get; set; }
+        public ManualResetEventSlim Connected { get; } = new(false);
+        public CancellationTokenSource Cancel { get; } = new();
+
+        public void Dispose()
+        {
+            try { Cancel.Cancel(); } catch { /* ignored */ }
+            try { ToRuffle.Dispose(); } catch { /* ignored */ }
+            try { FromRuffle.Dispose(); } catch { /* ignored */ }
+            try { Process?.Dispose(); } catch { /* ignored */ }
+        }
+    }
+
+    private const uint QS_SENDMESSAGE = 0x0040;
+    private const uint MWMO_INPUTAVAILABLE = 0x0004;
+    private const uint WAIT_OBJECT_0 = 0;
+    private const uint WAIT_TIMEOUT = 0x102;
+    private const uint PM_NOREMOVE = 0x0000;
+    private const uint PM_QS_SENDMESSAGE = QS_SENDMESSAGE << 16;
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct MSG
+    {
+        public IntPtr hwnd;
+        public uint message;
+        public IntPtr wParam;
+        public IntPtr lParam;
+        public uint time;
+        public int ptX;
+        public int ptY;
+    }
+
+    [DllImport("user32.dll")]
+    private static extern uint MsgWaitForMultipleObjectsEx(uint nCount, IntPtr[] pHandles, uint dwMilliseconds, uint dwWakeMask, uint dwFlags);
+
+    [DllImport("user32.dll")]
+    private static extern bool PeekMessage(out MSG lpMsg, IntPtr hWnd, uint wMsgFilterMin, uint wMsgFilterMax, uint wRemoveMsg);
+}
